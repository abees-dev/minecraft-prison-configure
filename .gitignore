# Minecraft Server Git Ignore

# Local secrets / deploy credentials
.env
.env.*

# Minecraft/Paper server executables and libraries
/*.jar
/cache/
/libraries/
/logs/
/versions/

# World folders (contains gigabytes of chunk data)
/world/
/world_nether/
/world_the_end/
/test/

# Runtime and dynamic server data files
/usercache.json
/usernamecache.json
/whitelist.json
/ops.json
/banned-ips.json
/banned-players.json

# Plugin executable files (.jar)
/plugins/*.jar
/plugins/**/*.jar

# Plugin temporary/updater/statistics directories
/plugins/update/
/plugins/Updater/
/plugins/bStats/
/plugins/pStats/
/plugins/PluginMetrics/

# Databases and temporary files
/*.db
/plugins/**/*.db
.DS_Store
Thumbs.db
/jre-17/

/world_prison/
.mmocore_inspect
skill/**/

# ItemsAdder / plugin resourcepack assets (large binary textures & models)
**/resourcepack/
**/mmoinv_rp_3/
world**/**/*.json
world**/**/*.dat
world**/**/*.mca
world**/**/*.mcb
world**/**/*.mcr
world**/**/*.mct
world**/**/*.mct
world_dungeon/*
world_dungeon_2/*
world_magadungeon/*
plugins/MMOItems/.jar_extracted/*
plugins/**/backups/*
world_pvp/*
world_plot/*
world_hub/*

# Player runtime data (auto-generated per player, not tracked)
/plugins/**/userdata/
/plugins/Multiverse-Inventories/players/
/plugins/Multiverse-Inventories/groups/*/*.json
/plugins/Multiverse-Inventories/worlds/*/*.json
/plugins/CorePlugin/altar-data.yml

# Skin / UUID caches (auto-fetched, safe to regenerate)
/plugins/SkinsRestorer/cache/
/plugins/SkinsRestorer/skins/
/plugins/SkinsRestorer/recommendations.json
/plugins/WorldGuard/cache/

# Native library extraction temp files
/plugins/RoseGarden/tmp/

# SQLite WAL/SHM/journal temp files
/plugins/**/*.db-shm
/plugins/**/*.db-wal
/plugins/**/*.db-journal

# Dailyquest runtime database
/dailyquest/data/

# Local console log
/.console_history

# FastAsyncWorldEdit clipboard buffers (large, ephemeral copy/paste data)
/plugins/FastAsyncWorldEdit/clipboard/