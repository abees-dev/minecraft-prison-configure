autoreel:
  display: '%group-color%Tự Cuốn'
  description: Tự động cuốn cần khi cá cắn câu.
  applies-to: Cần câu
  type: BITE_HOOK
  group: ULTIMATE
  settings:
    showActionBar: true
  applies:
    - FISHING_ROD
  levels:
    '1':
      chance: 25
      effects:
        - AUTO_REEL
    '2':
      chance: 50
      effects:
        - AUTO_REEL
    '3':
      chance: 75
      effects:
        - AUTO_REEL
    '4':
      effects:
        - AUTO_REEL
gemify:
  display: '%group-color%Hóa Khối'
  description: Có tỉ lệ biến quặng thành khối quặng.
  applies-to: Cuốc
  type: MINING
  group: FABLED
  settings:
    showActionBar: true
  applies:
    - ALL_PICKAXE
  levels:
    '1':
      conditions:
        - '%block natural% = true && %block type% contains ORE : %allow%'
      chance: 3
      cooldown: 5
      effects:
        - PARTICLE:GLOW:30:0.5 @Block
        - PLAY_SOUND:ENTITY_PLAYER_LEVELUP @Self
        - 'SET_BLOCK:GOLD_BLOCK @Block <condition>%block type% contains GOLD_ORE : %allow%</condition>'
        - 'SET_BLOCK:IRON_BLOCK @Block <condition>%block type% contains IRON_ORE : %allow%</condition>'
        - 'SET_BLOCK:COAL_BLOCK @Block <condition>%block type% contains COAL_ORE : %allow%</condition>'
        - 'SET_BLOCK:EMERALD_BLOCK @Block <condition>%block type% contains EMERALD_ORE : %allow%</condition>'
        - 'SET_BLOCK:COPPER_BLOCK @Block <condition>%block type% contains copper_ore : %allow%</condition>'
        - 'SET_BLOCK:REDSTONE_BLOCK @Block <condition>%block type% contains redstone_ore : %allow%</condition>'
        - 'SET_BLOCK:LAPIS_BLOCK @Block <condition>%block type% contains lapis_ore : %allow%</condition>'
        - 'SET_BLOCK:DIAMOND_BLOCK @Block <condition>%block type% contains diamond_ore : %allow%</condition>'
planter:
  display: '%group-color%Gieo Hạt'
  description: |-
    Gieo hạt trong vùng 3x3
    bằng shift+chuột phải.
  applies-to: Cuốc nông
  type: RIGHT_CLICK
  settings:
    showActionBar: true
  group: ULTIMATE
  applies:
    - ALL_HOE
  levels:
    '1':
      conditions:
        - '%player is sneaking% = true : %allow%'
      cooldown: 3
      effects:
        - PLANT_SEEDS:1
    '2':
      conditions:
        - '%player is sneaking% = true : %allow%'
      cooldown: 2
      effects:
        - PLANT_SEEDS:1
    '3':
      conditions:
        - '%player is sneaking% = true : %allow%'
      effects:
        - PLANT_SEEDS:1
