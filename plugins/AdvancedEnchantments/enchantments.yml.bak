  description: Tự trồng lại nông sản khi thu hoạch.
  applies-to: Cuốc nông
  type: MINING
  group: UNIQUE
  applies:
    - ALL_HOE
  levels:
    '1':
      conditions:
        - '%is crop% = false : %stop%'
        - '%is fully grown% = false : %stop%'
      effects:
        - PLANT_SEEDS:0:%block drop type%
