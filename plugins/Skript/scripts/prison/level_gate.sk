import:
	net.Indyuce.mmocore.api.player.PlayerData
	dev.drawethree.xprison.api.XPrisonAPI
	org.black_ixx.playerpoints.PlayerPoints

# ============================================================================
# HỆ THỐNG GIỚI HẠN LEVEL MMOCORE KHI RANKUP PRISON
# File: plugins/Skript/scripts/prison/level_gate.sk
#
# /rankup, /rankupmax, /autorankup của X-Prison bị chặn hẳn ở đây và tự xử lý
# lại toàn bộ: trừ tiền Vault (KHÔNG dùng currency nội bộ của X-Prison, module
# đó đang tắt vì nó tạo ra 1 ví tiền hoàn toàn tách biệt với Vault/Essentials -
# xem plugins/X-Prison/config.yml modules.currencies: false), sau đó gọi lệnh
# admin "setrank" của X-Prison để áp rank mới (đúng lệnh thật, xem
# reset_rank.sk). Giá mỗi rank vẫn đọc trực tiếp từ ranks.yml qua API của
# X-Prison (Rank.getCost()) - không hardcode giá ở đây để khi admin đổi giá
# trong ranks.yml thì không cần sửa lại file Skript này.
# ============================================================================

function get_next_rank_cost(rank_id: number) :: number:
	set {_core} to try XPrisonAPI.getInstance()
	if {_core} is not set:
		return 999999999999
	set {_ranksapi} to try {_core}.getRanksApi()
	if {_ranksapi} is not set:
		return 999999999999
	set {_rank} to try {_ranksapi}.getRankById({_rank_id})
	if {_rank} is not set:
		return 999999999999
	set {_cost} to try {_rank}.getCost()
	if {_cost} is not set:
		return 999999999999
	return {_cost}

# Giá point cho rankup bằng point (chuột phải) - tạm tính = giá money / 10,000,
# làm tròn đẹp. Chỉnh trực tiếp ở đây nếu muốn đổi giá point.
function get_next_rank_point_cost(rank_id: number) :: number:
	if {_rank_id} is 2:
		return 10
	if {_rank_id} is 3:
		return 30
	if {_rank_id} is 4:
		return 110
	if {_rank_id} is 5:
		return 540
	if {_rank_id} is 6:
		return 2170
	if {_rank_id} is 7:
		return 3200
	if {_rank_id} is 8:
		return 4350
	return 6450

function get_player_points(p: player) :: number:
	set {_pp} to try PlayerPoints.getInstance()
	if {_pp} is not set:
		return 0
	set {_ppapi} to try {_pp}.getAPI()
	if {_ppapi} is not set:
		return 0
	set {_bal} to try {_ppapi}.look({_p}'s uuid)
	if {_bal} is not set:
		return 0
	return {_bal}

function get_player_mmocore_level(p: player) :: number:
	set {_pd} to try PlayerData.get({_p})
	if {_pd} is set:
		return {_pd}.getLevel()
	return 1

function get_player_prison_rank(p: player) :: number:
	# KHÔNG dò qua permission LuckPerms group.xprison_rank_X nữa - nhóm LuckPerms
	# có thể không đồng bộ đúng lúc /setrank chạy (đã thấy sau /resetrank, X-Prison
	# xác nhận về Rank 1 nhưng permission group vẫn còn cũ). Hỏi thẳng rank thật
	# đang lưu trong X-Prison qua API là nguồn duy nhất đáng tin.
	set {_core} to try XPrisonAPI.getInstance()
	if {_core} is not set:
		return 1
	set {_ranksapi} to try {_core}.getRanksApi()
	if {_ranksapi} is not set:
		return 1
	set {_rank} to try {_ranksapi}.getPlayerRank({_p})
	if {_rank} is not set:
		return 1
	set {_id} to try {_rank}.getId()
	if {_id} is not set:
		return 1
	return {_id}

# Màu khớp đúng với từng rank trong ranks_master.yml (menu /rank), để message
# chat và menu luôn đồng bộ màu.
function get_rank_name(rank_id: number) :: text:
	if {_rank_id} is 1:
		return "&f&lTân Binh"
	if {_rank_id} is 2:
		return "&7&lTù Nhân"
	if {_rank_id} is 3:
		return "&a&lLao Công"
	if {_rank_id} is 4:
		return "&2&lThợ Đào"
	if {_rank_id} is 5:
		return "&b&lĐội Trưởng"
	if {_rank_id} is 6:
		return "&1&lPhó Quản Ngục"
	if {_rank_id} is 7:
		return "&d&lQuản Ngục"
	if {_rank_id} is 8:
		return "&6&lBá Chủ Ngục Tù"
	return "&c&lVượt Ngục"

function get_required_level_for_next_rank(current_rank: number) :: number:
	if {_current_rank} is 1:
		return 10
	if {_current_rank} is 2:
		return 20
	if {_current_rank} is 3:
		return 30
	if {_current_rank} is 4:
		return 45
	if {_current_rank} is 5:
		return 60
	if {_current_rank} is 6:
		return 75
	if {_current_rank} is 7:
		return 90
	return 100

function do_rankup(p: player):
	set {_current_rank} to get_player_prison_rank({_p})
	if {_current_rank} >= 9:
		send "&e&lRANKUP &7» &fBạn đã đạt Rank tối đa %get_rank_name(9)%&f rồi!" to {_p}
		stop

	set {_req_level} to get_required_level_for_next_rank({_current_rank})
	set {_current_level} to get_player_mmocore_level({_p})

	if {_current_level} < {_req_level}:
		play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
		send title "&c&lCHƯA ĐỦ ĐIỀU KIỆN" with subtitle "&fCần đạt &eLevel %{_req_level}% &fđể rankup" to {_p} for 3 seconds
		send "&c&lRANKUP &7» &fChưa đủ điều kiện lên %get_rank_name({_current_rank} + 1)%&f!" to {_p}
		send "&c&lRANKUP &7» &fCần &eLevel %{_req_level}% &7(Level hiện tại của bạn: &e%{_current_level}%&7)" to {_p}
		stop

	set {_next_rank} to {_current_rank} + 1
	set {_cost} to get_next_rank_cost({_next_rank})

	if {_p}'s balance < {_cost}:
		play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
		send "&c&lRANKUP &7» &fBạn không đủ tiền! Cần &f$%round({_cost})% &7(hiện có &e$%round({_p}'s balance)%&7)" to {_p}
		stop

	remove {_cost} from {_p}'s balance
	execute console command "setrank %{_p}'s name% %{_next_rank}%"
	send title "&a&l✔ RANK UP!" with subtitle "&fBạn đã lên %get_rank_name({_next_rank})%" to {_p} for 3 seconds
	send "&a&lRANKUP &7» &fChúc mừng, bạn đã lên %get_rank_name({_next_rank})%&7! &7(&f-$%round({_cost})%&7)" to {_p}
	play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

# Rankup bằng point (PlayerPoints) - chuột phải trong menu. Vẫn cần đủ Level
# MMOCore như rankup bằng tiền, chỉ khác loại tiền tệ bị trừ.
function do_rankup_point(p: player):
	set {_current_rank} to get_player_prison_rank({_p})
	if {_current_rank} >= 9:
		send "&e&lRANKUP &7» &fBạn đã đạt Rank tối đa %get_rank_name(9)%&f rồi!" to {_p}
		stop

	set {_req_level} to get_required_level_for_next_rank({_current_rank})
	set {_current_level} to get_player_mmocore_level({_p})

	if {_current_level} < {_req_level}:
		play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
		send title "&c&lCHƯA ĐỦ ĐIỀU KIỆN" with subtitle "&fCần đạt &eLevel %{_req_level}% &fđể rankup" to {_p} for 3 seconds
		send "&c&lRANKUP &7» &fChưa đủ điều kiện lên %get_rank_name({_current_rank} + 1)%&f!" to {_p}
		send "&c&lRANKUP &7» &fCần &eLevel %{_req_level}% &7(Level hiện tại của bạn: &e%{_current_level}%&7)" to {_p}
		stop

	set {_next_rank} to {_current_rank} + 1
	set {_cost} to get_next_rank_point_cost({_next_rank})
	set {_points} to get_player_points({_p})

	if {_points} < {_cost}:
		play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
		send "&c&lRANKUP &7» &fBạn không đủ point! Cần &f%{_cost}% point &7(hiện có &e%{_points}% point&7)" to {_p}
		stop

	set {_pp} to try PlayerPoints.getInstance()
	set {_ppapi} to try {_pp}.getAPI()
	try {_ppapi}.take({_p}'s uuid, {_cost})
	execute console command "setrank %{_p}'s name% %{_next_rank}%"
	send title "&a&l✔ RANK UP!" with subtitle "&fBạn đã lên %get_rank_name({_next_rank})%" to {_p} for 3 seconds
	send "&a&lRANKUP &7» &fChúc mừng, bạn đã lên %get_rank_name({_next_rank})%&7! &7(&f-%{_cost}% point&7)" to {_p}
	play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

# Gõ tay /rankup, /rankupmax, /autorankup vẫn bị chặn ở đây (cancel event hoạt
# động tốt với lệnh gõ tay thật từ client).
on command "rankup" or "rankupmax" or "autorankup":
	set {_p} to player
	if {_p} is not set:
		stop
	cancel event
	do_rankup({_p})

# Lệnh riêng để menu DeluxeMenus gọi (nút "[player] xrankup"). KHÔNG dùng
# "[player] rankup" trong menu nữa: DeluxeMenus gọi lệnh qua player.chat() giả
# lập, và "cancel event" ở on command phía trên không chặn được đường này một
# cách đáng tin cậy (đã xác nhận qua log - rankup từ menu vẫn rơi thẳng vào
# lệnh gốc lỗi của X-Prison dù đã cancel). Đăng ký hẳn 1 lệnh riêng để tránh
# hoàn toàn việc phải "chặn" lệnh của plugin khác.
command /xrankup:
	trigger:
		do_rankup(player)

# Chuột phải trong menu gọi lệnh này để rankup bằng point thay vì tiền.
command /xrankuppoint:
	trigger:
		do_rankup_point(player)

on command "ranks" or "rank":
	set {_p} to player
	if {_p} is set:
		cancel event
		execute {_p} command "dm open ranks_master"

