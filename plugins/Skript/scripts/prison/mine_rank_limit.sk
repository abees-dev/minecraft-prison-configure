import:
	com.sk89q.worldguard.WorldGuard
	com.sk89q.worldedit.bukkit.BukkitAdapter

# ============================================================================
# HỆ THỐNG GIỚI HẠN ĐÀO THEO RANK PRISON (RANK-BASED MINING RESTRICTION)
# File: plugins/Skript/scripts/prison/mine_rank_limit.sk
# Tích hợp: WorldGuard Region, X-Prison, MMOCore Level Gate
# ============================================================================

options:
	# Bật (true) hoặc Tắt (false) tính năng giới hạn số block đào tối đa mỗi ngày
	ENABLE_DAILY_LIMIT: false
	
# Lấy tên mỏ (WorldGuard Region) tại vị trí block
function get_mine_region_at(loc: location) :: text:
	set {_wg} to try WorldGuard.getInstance()
	if {_wg} is not set:
		return ""
	set {_container} to try {_wg}.getPlatform().getRegionContainer()
	if {_container} is not set:
		return ""
	set {_weLoc} to try BukkitAdapter.adapt({_loc})
	if {_weLoc} is not set:
		return ""
	set {_set} to try {_container}.createQuery().getApplicableRegions({_weLoc})
	if {_set} is not set:
		return ""
	set {_iterator} to try {_set}.iterator()
	if {_iterator} is not set:
		return ""
	while {_iterator}.hasNext():
		set {_region} to {_iterator}.next()
		set {_id} to {_region}.getId()
		if {_id} is "tan_binh" or "tu_nhan" or "lao_cong" or "tho_dao" or "doi_truong" or "pho_quan_nguc" or "quan_nguc" or "ba_chu_nguc_tu" or "vuot_nguc":
			return {_id}
	return ""

# Lấy Yêu cầu Rank ID tối thiểu (1 -> 9) để đào tại mỏ
function get_mine_required_rank(mine: text) :: number:
	if {_mine} is "tan_binh":
		return 1
	if {_mine} is "tu_nhan":
		return 2
	if {_mine} is "lao_cong":
		return 3
	if {_mine} is "tho_dao":
		return 4
	if {_mine} is "doi_truong":
		return 5
	if {_mine} is "pho_quan_nguc":
		return 6
	if {_mine} is "quan_nguc":
		return 7
	if {_mine} is "ba_chu_nguc_tu":
		return 8
	if {_mine} is "vuot_nguc":
		return 9
	return 0

# Tên hiển thị của Mỏ
function get_mine_display_name(mine: text) :: text:
	if {_mine} is "tan_binh":
		return "&f&lMỏ Tân Binh"
	if {_mine} is "tu_nhan":
		return "&7&lMỏ Tù Nhân"
	if {_mine} is "lao_cong":
		return "&a&lMỏ Lao Công"
	if {_mine} is "tho_dao":
		return "&2&lMỏ Thợ Đào"
	if {_mine} is "doi_truong":
		return "&b&lMỏ Đội Trưởng"
	if {_mine} is "pho_quan_nguc":
		return "&1&lMỏ Phó Quản Ngục"
	if {_mine} is "quan_nguc":
		return "&d&lMỏ Quản Ngục"
	if {_mine} is "ba_chu_nguc_tu":
		return "&6&lMỏ Bá Chủ Ngục Tù"
	if {_mine} is "vuot_nguc":
		return "&c&lMỏ Vượt Ngục"
	return "&7Mỏ Không Xác Định"

# Lấy giới hạn số block đào trong ngày theo Rank
function get_daily_block_limit(rank_id: number) :: number:
	if {_rank_id} is 1:
		return 5000
	if {_rank_id} is 2:
		return 10000
	if {_rank_id} is 3:
		return 20000
	if {_rank_id} is 4:
		return 35000
	if {_rank_id} is 5:
		return 50000
	if {_rank_id} is 6:
		return 75000
	if {_rank_id} is 7:
		return 100000
	if {_rank_id} is 8:
		return 150000
	return 999999999

# Kiểm tra & Tự động Reset ngày mới cho lượt đào
function check_daily_reset():
	set {_now} to now formatted as "yyyy-MM-dd"
	if {mine_limit::last_reset_date} is not set:
		set {mine_limit::last_reset_date} to {_now}
	else if {mine_limit::last_reset_date} is not {_now}:
		delete {mine_limit::daily_blocks::*}
		set {mine_limit::last_reset_date} to {_now}

# ----------------------------------------------------------------------------
# EVENT HANDLING
# ----------------------------------------------------------------------------

on break:
	# Bỏ qua kiểm tra đối với OP hoặc Creative
	if player is op:
		stop
	if player's gamemode is creative:
		stop
		
	set {_loc} to event-block's location
	set {_mine} to get_mine_region_at({_loc})
	
	# Nếu không nằm trong 9 mỏ ngục tù -> Cho phép đào bình thường
	if {_mine} is "":
		stop
		
	set {_req_rank} to get_mine_required_rank({_mine})
	if {_req_rank} <= 0:
		stop
		
	set {_user_rank} to get_player_prison_rank(player)
	
	# 1. KIỂM TRA CHẶN ĐÀO THEO RANK
	if {_user_rank} < {_req_rank}:
		cancel event
		set {_uuid} to player's uuid
		if {mine_limit::warn_cooldown::%{_uuid}%} is set:
			set {_elapsed} to difference between {mine_limit::warn_cooldown::%{_uuid}%} and now
			if {_elapsed} < 3 seconds:
				stop
		set {mine_limit::warn_cooldown::%{_uuid}%} to now
		play sound "block.note_block.bass" with volume 1 and pitch 1 to player
		send title "&c&lCHƯA ĐỦ RANK" with subtitle "&fCần Rank %get_rank_name({_req_rank})% &fđể đào mỏ này" to player for 2 seconds
		send "&c&lMỎ ĐÀO &7» &fBạn không đủ Rank để đào tại %get_mine_display_name({_mine})%&f!" to player
		send "&c&lMỎ ĐÀO &7» &fYêu cầu Rank %get_rank_name({_req_rank})% &7(Rank hiện tại của bạn: %get_rank_name({_user_rank})%&7)" to player
		send "&e&lMỎ ĐÀO &7» &fSử dụng lệnh &e/rank &fđể xem điều kiện RankUp!" to player
		stop
		
	# 2. KIỂM TRA GIỚI HẠN HÀNG NGÀY (NẾU BẬT)
	if {@ENABLE_DAILY_LIMIT} is true:
		check_daily_reset()
		set {_uuid} to player's uuid
		set {_current_blocks} to {mine_limit::daily_blocks::%{_uuid}%}
		if {_current_blocks} is not set:
			set {_current_blocks} to 0
			
		set {_limit} to get_daily_block_limit({_user_rank})
		if {_current_blocks} >= {_limit}:
			cancel event
			if {mine_limit::warn_cooldown::%{_uuid}%} is set:
				set {_elapsed} to difference between {mine_limit::warn_cooldown::%{_uuid}%} and now
				if {_elapsed} < 3 seconds:
					stop
			set {mine_limit::warn_cooldown::%{_uuid}%} to now
			play sound "block.note_block.bass" with volume 1 and pitch 1 to player
			send title "&c&lĐẠT GIỚI HẠN ĐÀO" with subtitle "&fĐã đạt %{_limit}% block/ngày" to player for 2 seconds
			send "&c&lGIỚI HẠN &7» &fBạn đã đào đạt giới hạn tối đa &e%{_limit}% block&f hôm nay!" to player
			send "&c&lGIỚI HẠN &7» &fNâng cấp Rank (&e/rank&f) để tăng giới hạn block đào mỗi ngày." to player
			stop
			
		# Tăng biến đếm block
		add 1 to {mine_limit::daily_blocks::%{_uuid}%}

# ----------------------------------------------------------------------------
# COMMANDS
# ----------------------------------------------------------------------------

command /minelimit [<text>] [<offlineplayer>]:
	aliases: /xmine, /minestatus, /limitchanmmo
	trigger:
		set {_p} to player
		if arg-1 is "reset":
			if sender is not console:
				if sender is not op:
					send "&cBạn không có quyền dùng lệnh này!" to sender
					stop
			if arg-2 is set:
				delete {mine_limit::daily_blocks::%arg-2's uuid%}
				send "&a&lMINELIMIT &7» &fĐã reset giới hạn block đào ngày hôm nay cho &e%arg-2's name%&f!" to sender
			else:
				send "&c&lMINELIMIT &7» &fCú pháp: /minelimit reset <tên_player>" to sender
			stop
			
		if arg-1 is "reload":
			if sender is not console:
				if sender is not op:
					send "&cBạn không có quyền dùng lệnh này!" to sender
					stop
			execute console command "sk reload prison/mine_rank_limit.sk"
			send "&a&lMINELIMIT &7» &fĐã reload script mine_rank_limit.sk thành công!" to sender
			stop
			
		# Mặc định: Hiển thị trạng thái đào cho người chơi
		check_daily_reset()
		set {_user_rank} to get_player_prison_rank({_p})
		set {_uuid} to {_p}'s uuid
		set {_current_blocks} to {mine_limit::daily_blocks::%{_uuid}%}
		if {_current_blocks} is not set:
			set {_current_blocks} to 0
		set {_limit} to get_daily_block_limit({_user_rank})
		
		send "&6&m==========================================" to {_p}
		send "   &e&lTHÔNG TIN GIỚI HẠN MỎ ĐÀO PRISON" to {_p}
		send "&6&m==========================================" to {_p}
		send " &7• Rank hiện tại: %get_rank_name({_user_rank})%" to {_p}
		send " &7• Mỏ cao nhất được phép đào: %get_mine_display_name("tan_binh")% &7đến %get_mine_display_name(get_mine_name_by_rank({_user_rank}))%" to {_p}
		if {@ENABLE_DAILY_LIMIT} is true:
			send " &7• Đã đào hôm nay: &e%{_current_blocks}% &7/ &a%{_limit}% blocks" to {_p}
		else:
			send " &7• Giới hạn block/ngày: &aKhông giới hạn (Un-limited)" to {_p}
		send "&6&m==========================================" to {_p}

function get_mine_name_by_rank(rank_id: number) :: text:
	if {_rank_id} is 1:
		return "tan_binh"
	if {_rank_id} is 2:
		return "tu_nhan"
	if {_rank_id} is 3:
		return "lao_cong"
	if {_rank_id} is 4:
		return "tho_dao"
	if {_rank_id} is 5:
		return "doi_truong"
	if {_rank_id} is 6:
		return "pho_quan_nguc"
	if {_rank_id} is 7:
		return "quan_nguc"
	if {_rank_id} is 8:
		return "ba_chu_nguc_tu"
	return "vuot_nguc"
