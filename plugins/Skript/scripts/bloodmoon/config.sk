# ============================================================================
# ĐÊM NGUYỆT HUYẾT — CONFIG
# File: plugins/Skript/scripts/bloodmoon/config.sk
# Boss: VAMPIRE_LORD_BOSS (vampire_lord_boss.yml + VFX bloodmoon_vampire_mobs.yml)
# ============================================================================

# --- Lịch mặc định (giờ server) ---
# Thứ 7: 20:00 bắt đầu → 22:00 kết thúc (2 giờ)
function get_bm_start_hour() :: number:
	return 20

function get_bm_end_hour() :: number:
	return 22

function get_bm_warn_hour() :: number:
	return 19

function get_bm_warn_minute() :: number:
	return 50

# --- Spawn mặc định (đổi bằng /nguyethuyet setspawn) ---
# Mặc định gần boss Tân Binh dungeon — admin nên setspawn tại khu event thật.
function get_bm_default_world() :: text:
	return "world_dungeon"

function get_bm_default_x() :: number:
	return -56

function get_bm_default_y() :: number:
	return 61

function get_bm_default_z() :: number:
	return 21

function get_bm_boss_id() :: text:
	return "VAMPIRE_LORD_BOSS"

function get_bm_boss_level() :: number:
	return 10

# --- Messages ---
function get_bm_msg(key: text) :: text:
	if {_key} is "WARN":
		return "&5&l⚔ NGUYỆT HUYẾT &8» &fCòn &e10 phút&f nữa Đêm Nguyệt Huyết bắt đầu! Chuẩn bị vào &dDungeon&f."
	if {_key} is "START":
		return "&5&l⚔ ĐÊM NGUYỆT HUYẾT &8» &cBắt đầu! &fBá Tước Huyết Nguyệt đã thức tỉnh. &7(/warp dungeon hoặc vào world_dungeon)"
	if {_key} is "END":
		return "&5&l⚔ NGUYỆT HUYẾT &8» &fĐêm đã tàn. Ánh trăng máu phai đi..."
	if {_key} is "ALREADY":
		return "&c&l[Nguyệt Huyết] &fSự kiện đang diễn ra rồi!"
	if {_key} is "NOT_ACTIVE":
		return "&c&l[Nguyệt Huyết] &fHiện không có Đêm Nguyệt Huyết."
	if {_key} is "SPAWN_SET":
		return "&a&l[Nguyệt Huyết] &fĐã lưu điểm spawn boss tại vị trí của bạn."
	return "&c[Nguyệt Huyết] &f?"
