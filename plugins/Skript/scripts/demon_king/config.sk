# ============================================================================
# DEMON KING ALTAR SYSTEM CONFIGURATION
# File: plugins/Skript/scripts/demon_king/config.sk
# ============================================================================

function get_mavuong_msg(key: text, val1: text = "", val2: text = "") :: text:
	if {_key} is "COOLDOWN":
		return "&e&l[Bàn Thờ] &fMa Vương vừa được triệu hồi gần đây, hãy quay lại sau &c%{_val1}% phút %{_val2}% giây&f!"

	if {_key} is "NO_KEY":
		return "&c&l[Bàn Thờ] &fBạn cần &e1 Huy Hiệu Triệu Hồi &f(chế từ Huy Hiệu Vỡ rớt ở 9 Boss trong Nhà Tù) để đánh thức Ma Vương!"

	if {_key} is "SUMMON_START":
		return "&6&l[Bàn Thờ] &fHuy Hiệu Triệu Hồi đã phát sáng... Ma Vương Ngục Tù sắp thức tỉnh!"

	if {_key} is "BOSS_SPAWNED":
		return "&4&l[TRÙM CUỐI] &fMa Vương Ngục Tù đã xuất hiện!"

	return ""

function get_mavuong_cooldown() :: number:
	return 1800 # 30 minutes (1800s)

function get_mavuong_boss_spawn_cmd() :: text:
	return "mm mobs spawn PRISON_MA_VUONG_BOSS:10 1 world_magadungeon,-2,81,86"

function get_mavuong_holo_name() :: text:
	return "MaVuongTimer"
