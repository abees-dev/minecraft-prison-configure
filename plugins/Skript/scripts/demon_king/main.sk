import:
	io.lumine.mythic.lib.api.item.NBTItem

# ============================================================================
# DEMON KING ALTAR SUMMON SYSTEM (MAIN LOGIC)
# File: plugins/Skript/scripts/demon_king/main.sk
# ============================================================================

on right click on armor stand:
	if name of event-entity does not contain "Bàn Thờ Triệu Hồi Ma Vương":
		stop trigger

	# Anti-spam click limit (5s per player)
	if {mavuong_altar_last_click::%player's uuid%} is set:
		if difference between {mavuong_altar_last_click::%player's uuid%} and now < 5 seconds:
			stop trigger
	set {mavuong_altar_last_click::%player's uuid%} to now

	# Check Summon Cooldown
	if {mavuong_altar_cooldown_left} is set:
		if {mavuong_altar_cooldown_left} > 0:
			set {_min} to floor({mavuong_altar_cooldown_left} / 60)
			set {_sec} to {mavuong_altar_cooldown_left} - ({_min} * 60)

			set {_msg} to get_mavuong_msg("COOLDOWN", "%{_min}%", "%{_sec}%")
			send {_msg} to player
			stop trigger

	# Check Summon Badge Item in inventory
	set {_has_item} to false
	loop all items in player's inventory:
		if loop-value is not air:
			set {_realitem} to item in loop-value
			set {_nbt} to try NBTItem.get({_realitem})
			if {_nbt} is set:
				set {_id} to try {_nbt}.getString("MMOITEMS_ITEM_ID")
				if {_id} is "HUY_HIEU_TRIEU_HOI":
					set {_has_item} to true
					stop loop

	if {_has_item} is false:
		set {_msg} to get_mavuong_msg("NO_KEY")
		send {_msg} to player
		stop trigger

	# Deduct Item & Set Cooldown
	execute console command "mmoitems take MATERIAL HUY_HIEU_TRIEU_HOI %player's name% 1"
	set {mavuong_altar_cooldown_left} to get_mavuong_cooldown()
	
	set {_msg_start} to get_mavuong_msg("SUMMON_START")
	send {_msg_start} to player

	set {_summonplayer} to player
	wait 3 seconds
	
	# Spawn Boss via MythicMobs
	set {_spawn_cmd} to get_mavuong_boss_spawn_cmd()
	execute console command {_spawn_cmd}
	
	if {_summonplayer} is online:
		set {_msg_boss} to get_mavuong_msg("BOSS_SPAWNED")
		send {_msg_boss} to {_summonplayer}

# Update Hologram Timer every 5s
every 5 seconds:
	set {_holo_name} to get_mavuong_holo_name()
	if {mavuong_altar_cooldown_left} is set:
		if {mavuong_altar_cooldown_left} > 0:
			subtract 5 from {mavuong_altar_cooldown_left}
			if {mavuong_altar_cooldown_left} > 0:
				set {_min} to floor({mavuong_altar_cooldown_left} / 60)
				set {_sec} to {mavuong_altar_cooldown_left} - ({_min} * 60)

				execute console command "dh line set %{_holo_name}% 1 2 &7Có thể triệu hồi lại sau: &c%{_min}% phút %{_sec}% giây"
				stop

	set {mavuong_altar_cooldown_left} to 0
	execute console command "dh line set %{_holo_name}% 1 2 &aSẵn sàng - Click chuột phải để triệu hồi!"
