import:
	net.Indyuce.mmocore.api.player.PlayerData
	net.Indyuce.mmocore.api.event.PlayerExperienceGainEvent
	io.lumine.mythic.lib.api.item.NBTItem

# ============================================================================
# REBIRTH & PERK TREE SYSTEM (MAIN LOGIC)
# File: plugins/Skript/scripts/rebirth/main.sk
# Main Commands: /chuyensinh, /rebirth, /setcs, /resetcs, /csaura, /givedachuyensinh
# ============================================================================

function get_cs_mmocore_level(p: player) :: number:
	set {_pd} to try PlayerData.get({_p})
	if {_pd} is set:
		return {_pd}.getLevel()
	return 1

function get_cs_rank(p: player) :: number:
	loop 9 times:
		set {_r} to 10 - loop-number
		if {_p} has permission "group.xprison_rank_%{_r}%":
			return {_r}
	return 1

function has_da_chuyen_sinh(p: player) :: boolean:
	loop all items in {_p}'s inventory:
		if loop-value is not air:
			set {_realitem} to item in loop-value
			set {_nbt} to try NBTItem.get({_realitem})
			if {_nbt} is set:
				set {_id} to try {_nbt}.getString("MMOITEMS_ITEM_ID")
				if {_id} is "DA_CHUYEN_SINH":
					return true
	return false

function reset_player_rank_and_mmocore(p: player):
	# Reset MMOCore Level & EXP via Java API (Giữ nguyên Rank Prison)
	set {_pd} to try PlayerData.get({_p})
	if {_pd} is set:
		try {_pd}.setLevel(1)
		try {_pd}.setExperience(0)

	# Console Command Fallbacks cho MMOCore Level
	execute console command "mmocore admin level set %{_p}'s name% 1"
	execute console command "mmocore admin set level %{_p}'s name% 1"
	execute console command "mmocore admin set-level %{_p}'s name% 1"

command /chuyensinh:
	aliases: /rebirth
	trigger:
		open_chuyensinh_main_gui(player)

# Command cho Admin cấp Đá Chuyển Sinh
command /givedachuyensinh [<player>] [<number=1>]:
	permission: op
	trigger:
		set {_target} to arg-1 ? player
		execute console command "mmoitems give MATERIAL DA_CHUYEN_SINH %{_target}'s name% %arg-2%"
		send "&a&l[ADMIN] &fĐã trao &e%arg-2%x Đá Chuyển Sinh &fcho &b%{_target}'s name%&f!" to player

# Command Set CS cho Admin test
command /setcs <player> <number>:
	permission: op
	trigger:
		set {chuyensinh::%arg-1's uuid%} to arg-2
		set {_prefix} to get_cs_prefix(arg-2)
		execute console command "lp user %arg-1's name% meta setprefix 100 ""%{_prefix}%"""
		send "&a&l[ADMIN] &fĐã đặt cấp Chuyển Sinh cho &e%arg-1's name% &fthành &aLần %arg-2%&f!" to player

# Command Reset toàn bộ Chuyển Sinh cho Player
command /resetcs <player>:
	permission: op
	trigger:
		set {_u} to arg-1's uuid
		delete {chuyensinh::%{_u}%}
		delete {cs_points::%{_u}%}
		delete {cs_perk_speed::%{_u}%}
		delete {cs_perk_damage::%{_u}%}
		delete {cs_perk_defense::%{_u}%}
		delete {cs_perk_lifesteal::%{_u}%}
		delete {cs_perk_money::%{_u}%}
		delete {cs_perk_drop::%{_u}%}
		delete {cs_aura_toggle::%{_u}%}
		execute console command "lp user %arg-1's name% meta setprefix 100 """""
		send "&a&l[ADMIN] &fĐã reset toàn bộ dữ liệu Chuyển Sinh & Cây Kỹ Năng của &e%arg-1's name% &fvề 0!" to player

# Command Dynamic Bật/Tắt Hào Quang Cấp Server cho Admin
command /csaura <boolean>:
	permission: op
	trigger:
		set {cs_system_aura_enabled} to arg-1
		if arg-1 is true:
			send "&a&l[ADMIN] &fĐã &a&lBẬT &fhiệu ứng Hào Quang Particle toàn Server!" to player
		else:
			send "&c&l[ADMIN] &fĐã &c&lTẮT &fhiệu ứng Hào Quang Particle toàn Server!" to player

function open_chuyensinh_main_gui(p: player):
	set {_uuid} to uuid of {_p}
	set {_cs} to {chuyensinh::%{_uuid}%} ? 0
	set {_pts} to {cs_points::%{_uuid}%} ? 0
	set {_max_cs} to get_cs_max_level()

	# Lấy thông tin điều kiện Chuyển Sinh trước
	set {_rank} to get_cs_rank({_p})
	set {_lvl} to get_cs_mmocore_level({_p})
	set {_money} to {_p}'s balance
	set {_req_money} to get_cs_req_money()
	set {_has_stone} to has_da_chuyen_sinh({_p})

	set {_title} to get_cs_gui_title()
	set {_inv} to a new chest inventory with 6 rows named {_title}

	# 1. Background Filler (Kính Xám + Kính Tím Trang Trí Các Góc)
	loop 54 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named "&7"

	# Các góc trang trí huyền bí
	set slot 0 of {_inv} to purple stained glass pane named "&d✦"
	set slot 8 of {_inv} to purple stained glass pane named "&d✦"
	set slot 45 of {_inv} to purple stained glass pane named "&d✦"
	set slot 53 of {_inv} to purple stained glass pane named "&d✦"

	# ---------------- ROW 1: THÔNG TIN CHÍNH (Slot 4) ----------------
	if {_cs} >= {_max_cs}:
		set slot 4 of {_inv} to nether star named "&d&l❖ THÔNG TIN CHUYỂN SINH ❖" with lore "&7• Cấp Chuyển Sinh hiện tại: &e&lCấp %{_cs}% &7/ &c%{_max_cs}% (ĐÃ ĐẠT MAX)", "&7• Điểm Kỹ Năng chưa dùng: &a&l%{_pts}% Điểm", "&7• Cấp độ MMOCore hiện tại: &e&lLevel %{_lvl}% &7/ &a100", "&7• Bonus EXP MMOCore: &a&l+%{_cs} * 5%%% EXP &7(vĩnh viễn)", "&f", "&d&l✦ TRẠNG THÁI: &c&lĐÃ ĐẠT CẤP CHUYỂN SINH TỐI ĐA (20/20)!"
	else:
		set slot 4 of {_inv} to nether star named "&d&l❖ THÔNG TIN CHUYỂN SINH ❖" with lore "&7• Cấp Chuyển Sinh hiện tại: &e&lCấp %{_cs}% &7/ &a%{_max_cs}%", "&7• Điểm Kỹ Năng chưa dùng: &a&l%{_pts}% Điểm", "&7• Cấp độ MMOCore hiện tại: &e&lLevel %{_lvl}% &7/ &a100", "&7• Bonus EXP MMOCore: &a&l+%{_cs} * 5%%% EXP &7(vĩnh viễn)", "&f", "&d&l✦ QUYỀN LỢI MỖI LẦN CHUYỂN SINH:", "&a✔ &e+3 Điểm Kỹ Năng &7nâng cấp Cây Kỹ Năng", "&a✔ &a+5%% EXP MMOCore &7tự động tăng khi cày quái", "&a✔ &7Mở khóa &dPrefix Chat &7& &eHào Quang Particle", "&f", "&c&l⚠ LƯU Ý BẮT BUỘC:", "&7Chuyển Sinh sẽ reset &cLevel MMOCore &7về &fLevel 1&7!", "&7(Giữ nguyên Rank Prison không bị reset)"

	# ---------------- ROW 2: 4 ĐIỀU KIỆN (Slots 10..13) & XÁC NHẬN (Slot 15) ----------------
	# Slot 10: Điều kiện Rank 9
	if {_rank} >= get_cs_req_rank():
		set slot 10 of {_inv} to lime concrete named "&a&l✔ RANK PRISON &8» &a&lĐÃ ĐẠT" with lore "&7• Yêu cầu: &e&lRank 9 [Vượt Ngục]", "&7• Tiến trình: &a&lRank 9 / 9"
	else:
		set slot 10 of {_inv} to red concrete named "&c&l✖ RANK PRISON &8» &c&lCHƯA ĐẠT" with lore "&7• Yêu cầu: &e&lRank 9 [Vượt Ngục]", "&7• Tiến trình: &c&lRank %{_rank}% / 9"

	# Slot 11: Điều kiện Level 100
	if {_lvl} >= get_cs_req_level():
		set slot 11 of {_inv} to lime concrete named "&a&l✔ MMOCORE LEVEL &8» &a&lĐÃ ĐẠT" with lore "&7• Yêu cầu: &e&lLevel 100 MMOCore", "&7• Tiến trình: &a&lLevel %{_lvl}% / 100"
	else:
		set slot 11 of {_inv} to red concrete named "&c&l✖ MMOCORE LEVEL &8» &c&lCHƯA ĐẠT" with lore "&7• Yêu cầu: &e&lLevel 100 MMOCore", "&7• Tiến trình: &c&lLevel %{_lvl}% / 100"

	# Slot 12: Điều kiện Money 100M
	if {_money} >= {_req_money}:
		set slot 12 of {_inv} to lime concrete named "&a&l✔ CHI PHÍ MONEY &8» &a&lĐÃ ĐẠT" with lore "&7• Yêu cầu: &e&l$100,000,000 Money", "&7• Số dư hiện có: &a&l$%round({_money})%"
	else:
		set slot 12 of {_inv} to red concrete named "&c&l✖ CHI PHÍ MONEY &8» &c&lCHƯA ĐẠT" with lore "&7• Yêu cầu: &e&l$100,000,000 Money", "&7• Số dư hiện có: &c&l$%round({_money})% / $100M"

	# Slot 13: Điều kiện Đá Chuyển Sinh
	if {_has_stone} is true:
		set slot 13 of {_inv} to lime concrete named "&a&l✔ ĐÁ CHUYỂN SINH &8» &a&lĐÃ ĐẠT" with lore "&7• Yêu cầu: &e&l1x Đá Chuyển Sinh", "&7• Trạng thái: &a&lCÓ TRONG TÚI ĐỒ"
	else:
		set slot 13 of {_inv} to red concrete named "&c&l✖ ĐÁ CHUYỂN SINH &8» &c&lCHƯA ĐẠT" with lore "&7• Yêu cầu: &e&l1x Đá Chuyển Sinh", "&7• Trạng thái: &c&lTHIẾU ĐÁ CHUYỂN SINH"

	# Slot 15: Nút xác nhận Chuyển Sinh
	if {_cs} >= {_max_cs}:
		set slot 15 of {_inv} to barrier named "&c&l🔒 [ ĐÃ ĐẠT CẤP TỐI ĐA ]" with lore "&7Bạn đã đạt Cấp Chuyển Sinh tối đa (%{_max_cs}%/%{_max_cs}%)!"
	else if {_rank} >= get_cs_req_rank():
		if {_lvl} >= get_cs_req_level():
			if {_money} >= {_req_money}:
				if {_has_stone} is true:
					set slot 15 of {_inv} to beacon named "&a&l❖ [ XÁC NHẬN CHUYỂN SINH ] ❖" with lore "&7Click để tiến hành Chuyển Sinh ngay!", "&7Tiêu hao &e$100M Money &7+ &d1x Đá Chuyển Sinh", "&7Nhận ngay &a+3 Điểm Kỹ Năng&7!"
				else:
					set slot 15 of {_inv} to barrier named "&c&l🔒 [ CHƯA ĐỦ ĐIỀU KIỆN ]" with lore "&7Bạn thiếu 1x Đá Chuyển Sinh trong túi đồ!"
			else:
				set slot 15 of {_inv} to barrier named "&c&l🔒 [ CHƯA ĐỦ ĐIỀU KIỆN ]" with lore "&7Bạn chưa đủ $100,000,000 Money!"
		else:
			set slot 15 of {_inv} to barrier named "&c&l🔒 [ CHƯA ĐỦ ĐIỀU KIỆN ]" with lore "&7Bạn cần MMOCore Level 100 (Hiện tại: Level %{_lvl}%/100)!"
	else:
		set slot 15 of {_inv} to barrier named "&c&l🔒 [ CHƯA ĐỦ ĐIỀU KIỆN ]" with lore "&7Bạn cần Rank 9 [Vượt Ngục] (Hiện tại: Rank %{_rank}%/9)!"

	# ---------------- ROW 3: DIVIDER BANNER (Row 18..26) ----------------
	loop 9 times:
		set slot (17 + loop-number) of {_inv} to black stained glass pane named "&8&m---------------------------------"
	set slot 22 of {_inv} to book named "&d&l❖ CÂY KỸ NĂNG CHUYỂN SINH ❖" with lore "&7Sử dụng Điểm Kỹ Năng để gia tăng", "&7vĩnh viễn sức mạnh cho nhân vật!"

	# ---------------- ROW 4: CÂY KỸ NĂNG (Slots 28..33) ----------------
	# Slot 28: Perk 1 - Thần Phong
	set {_lvl_speed} to {cs_perk_speed::%{_uuid}%} ? 0
	set slot 28 of {_inv} to feather named "&e&l⚡ THẦN PHONG &8[ &fCấp %{_lvl_speed}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7+3%% Tốc độ di chuyển", "&a+ &7+5%% Tốc độ đào mỏ (Haste)", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Speed: &a+%{_lvl_speed} * 3%%%", "&7• Haste: &a+%{_lvl_speed} * 5%%%", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# Slot 29: Perk 2 - Sát Thương Thần Thoại
	set {_lvl_dmg} to {cs_perk_damage::%{_uuid}%} ? 0
	set slot 29 of {_inv} to diamond sword named "&c&l🗡️ SÁT THƯƠNG THẦN THOẠI &8[ &fCấp %{_lvl_dmg}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7+4%% Sát Thương Đánh Thường & Skill", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Sát thương tăng thêm: &c+%{_lvl_dmg} * 4%%%", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# Slot 30: Perk 3 - Bất Hoại
	set {_lvl_def} to {cs_perk_defense::%{_uuid}%} ? 0
	set slot 30 of {_inv} to shield named "&b&l🛡️ BẤT HOẠI &8[ &fCấp %{_lvl_def}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7-3%% Sát Thương Nhận Vào", "&a+ &7+50 Máu Tối Đa (Max HP)", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Giảm sát thương: &b-%{_lvl_def} * 3%%%", "&7• Máu cộng thêm: &b+%{_lvl_def} * 50% HP", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# Slot 31: Perk 4 - Huyết Ma
	set {_lvl_life} to {cs_perk_lifesteal::%{_uuid}%} ? 0
	set slot 31 of {_inv} to redstone named "&4&l🩸 HUYẾT MA &8[ &fCấp %{_lvl_life}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7+1.5%% Hút Máu (Lifesteal) mọi đòn đánh", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Tỷ lệ hút máu: &c+%{_lvl_life} * 1.5%%%", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# Slot 32: Perk 5 - Phú Hộ
	set {_lvl_money} to {cs_perk_money::%{_uuid}%} ? 0
	set slot 32 of {_inv} to gold ingot named "&6&l💰 PHÚ HỘ &8[ &fCấp %{_lvl_money}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7+10%% Giá Bán Mỏ (/sellall)", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Thưởng giá sell mỏ: &6+%{_lvl_money} * 10%%%", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# Slot 33: Perk 6 - May Mắn Thần Thánh
	set {_lvl_drop} to {cs_perk_drop::%{_uuid}%} ? 0
	set slot 33 of {_inv} to emerald named "&a&l💎 MAY MẮN THẦN THÁNH &8[ &fCấp %{_lvl_drop}%/10 &8]" with lore "&7Hiệu ứng mỗi cấp nâng:", "&a+ &7+5%% Tỷ lệ rớt Đá Cường Hóa từ Quái", "&f", "&8✦ &7Tùy chọn hiện tại:", "&7• Tỷ lệ drop đá tăng thêm: &a+%{_lvl_drop} * 5%%%", "&f", "&e▸ Giá nâng cấp: &a1 Điểm Kỹ Năng", "&a➤ Click để nâng cấp ngay!"

	# ---------------- ROW 6: NÚT ĐIỀU KHIỂN HÀO QUANG (Slot 49) ----------------
	set {_aura} to {cs_aura_toggle::%{_uuid}%}
	if {_aura} is not false:
		set slot 49 of {_inv} to ender eye named "&a&l✨ HÀO QUANG PARTICLE &8[ &aBẬT &8]" with lore "&7Hào quang hiển thị theo Cấp Chuyển Sinh.", "&e➤ Click để TẮT hiệu ứng hào quang."
	else:
		set slot 49 of {_inv} to ender pearl named "&c&l✨ HÀO QUANG PARTICLE &8[ &cTẮT &8]" with lore "&7Hào quang hiển thị theo Cấp Chuyển Sinh.", "&e➤ Click để BẬT hiệu ứng hào quang."

	open {_inv} to {_p}

# ============================================================================
# GUI CLICK EVENTS & REBIRTH LOGIC
# ============================================================================

on inventory click:
	set {_title} to get_cs_gui_title()
	if name of top inventory of player contains {_title} or "CHUYỂN SINH":
		cancel event
		if clicked inventory is top inventory of player:
			set {_p} to player
			set {_uuid} to uuid of {_p}
			set {_slot} to index of clicked slot

			# Slot 15: Rebirth Action (Beacon / Barrier)
			if {_slot} is 15:
				set {_cs} to {chuyensinh::%{_uuid}%} ? 0
				set {_max_cs} to get_cs_max_level()

				if {_cs} >= {_max_cs}:
					send "&c&l❖ [LỖI] &fBạn đã đạt Cấp Chuyển Sinh tối đa (&e%{_max_cs}%/%{_max_cs}%&f)!" to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop

				set {_rank} to get_cs_rank({_p})
				set {_lvl} to get_cs_mmocore_level({_p})
				set {_money} to {_p}'s balance
				set {_req_money} to get_cs_req_money()
				set {_has_stone} to has_da_chuyen_sinh({_p})

				if {_rank} < get_cs_req_rank():
					send "&c&l❖ [LỖI] &fBạn phải đạt &e&lRank 9 [Vượt Ngục] &fmới có thể Chuyển Sinh!" to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop
				if {_lvl} < get_cs_req_level():
					send "&c&l❖ [LỖI] &fBạn phải đạt &e&lMMOCore Level 100 &fmới có thể Chuyển Sinh!" to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop
				if {_money} < {_req_money}:
					send "&c&l❖ [LỖI] &fBạn cần &e&l$100,000,000 Money &fđể Chuyển Sinh!" to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop
				if {_has_stone} is false:
					send "&c&l❖ [LỖI] &fBạn cần &d&l1x Đá Chuyển Sinh &ftrong túi đồ để Chuyển Sinh!" to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop

				# Process Rebirth & Deduct Items/Money
				remove {_req_money} from {_p}'s balance
				execute console command "mmoitems take MATERIAL DA_CHUYEN_SINH %{_p}'s name% 1"
				close inventory of {_p}

				add 1 to {chuyensinh::%{_uuid}%}
				set {_new_cs} to {chuyensinh::%{_uuid}%}

				# Award Skill Points
				add get_cs_points_per_rebirth() to {cs_points::%{_uuid}%}

				# Reset MMOCore Level (Giữ nguyên Rank Prison)
				reset_player_rank_and_mmocore({_p})

				# Update LuckPerms Chat Prefix via get_cs_prefix
				set {_prefix} to get_cs_prefix({_new_cs})
				execute console command "lp user %{_p}'s name% meta setprefix 100 ""%{_prefix}%"""

				send title "&a&lCHUYỂN SINH THÀNH CÔNG!" with subtitle "&fCấp Chuyển Sinh: &e&lLần %{_new_cs}% &7(+3 Điểm Kỹ Năng)" to {_p} for 4 seconds
				play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 to {_p}

				broadcast "&d&l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
				broadcast "&d&l❖ HỆ THỐNG CHUYỂN SINH ❖"
				broadcast "&fNgười chơi &e&l%{_p}'s name% &fđã xuất sắc &a&lCHUYỂN SINH LẦN %{_new_cs}%&f!"
				broadcast "&7• Reset về &fMMOCore Level 1 &7(Giữ nguyên Rank Prison)."
				broadcast "&7• Tiêu hao &d1x Đá Chuyển Sinh &7và nhận &a&l+3 Điểm Kỹ Năng&7!"
				broadcast "&7• Thưởng vĩnh viễn &a&l+%{_new_cs} * 5%%% EXP MMOCore &7từ quái!"
				broadcast "&d&l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
				stop

			# Slot 49: Particle Aura Toggle
			if {_slot} is 49:
				if {cs_aura_toggle::%{_uuid}%} is false:
					set {cs_aura_toggle::%{_uuid}%} to true
					send "&a&l❖ [HÀO QUANG] &fĐã &a&lBẬT &fhiệu ứng Hào Quang Chuyển Sinh!" to {_p}
				else:
					set {cs_aura_toggle::%{_uuid}%} to false
					send "&c&l❖ [HÀO QUANG] &fĐã &c&lTẮT &fhiệu ứng Hào Quang Chuyển Sinh!" to {_p}
				open_chuyensinh_main_gui({_p})
				stop

			# Perk Tree Upgrades
			set {_pts} to {cs_points::%{_uuid}%} ? 0

			if {_slot} is 28 or 29 or 30 or 31 or 32 or 33:
				if {_pts} <= 0:
					send "&c&l❖ [LỖI] &fBạn không có đủ Điểm Kỹ Năng Chuyển Sinh! Hãy Chuyển Sinh để nhận thêm điểm." to {_p}
					play sound "block.note_block.bass" with volume 1 and pitch 1 to {_p}
					stop

				# Perk 1: Thần Phong (Slot 28)
				if {_slot} is 28:
					set {_cur} to {cs_perk_speed::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &e⚡ Thần Phong &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_speed::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &e⚡ Thần Phong &flên &e&lCấp %{cs_perk_speed::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				# Perk 2: Sát Thương Thần Thoại (Slot 29)
				if {_slot} is 29:
					set {_cur} to {cs_perk_damage::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &c🗡️ Sát Thương Thần Thoại &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_damage::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &c🗡️ Sát Thương Thần Thoại &flên &e&lCấp %{cs_perk_damage::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				# Perk 3: Bất Hoại (Slot 30)
				if {_slot} is 30:
					set {_cur} to {cs_perk_defense::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &b🛡️ Bất Hoại &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_defense::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &b🛡️ Bất Hoại &flên &e&lCấp %{cs_perk_defense::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				# Perk 4: Huyết Ma (Slot 31)
				if {_slot} is 31:
					set {_cur} to {cs_perk_lifesteal::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &4🩸 HUYẾT MA &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_lifesteal::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &4🩸 HUYẾT MA &flên &e&lCấp %{cs_perk_lifesteal::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				# Perk 5: Phú Hộ (Slot 32)
				if {_slot} is 32:
					set {_cur} to {cs_perk_money::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &6💰 PHÚ HỘ &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_money::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &6💰 PHÚ HỘ &flên &e&lCấp %{cs_perk_money::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				# Perk 6: May Mắn Thần Thánh (Slot 33)
				if {_slot} is 33:
					set {_cur} to {cs_perk_drop::%{_uuid}%} ? 0
					if {_cur} >= 10:
						send "&c&l❖ [NÂNG CẤP] &fKỹ năng &a💎 MAY MẮN THẦN THÁNH &fđã đạt Cấp tối đa (10/10)!" to {_p}
						stop
					add 1 to {cs_perk_drop::%{_uuid}%}
					subtract 1 from {cs_points::%{_uuid}%}
					send "&a&l❖ [NÂNG CẤP] &fĐã nâng cấp kỹ năng &a💎 MAY MẮN THẦN THÁNH &flên &e&lCấp %{cs_perk_drop::%{_uuid}%}%/10&f!" to {_p}
					play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}

				open_chuyensinh_main_gui({_p})

# ============================================================================
# COMBAT BUFFS & REBIRTH PERK LISTENERS
# ============================================================================

on damage:
	if attacker is not a player:
		if victim is not a player:
			stop

	# Attacker Damage & Lifesteal Buff
	if attacker is a player:
		set {_att_uuid} to uuid of attacker
		set {_dmg_lvl} to {cs_perk_damage::%{_att_uuid}%} ? 0
		if {_dmg_lvl} > 0:
			set damage to damage * (1 + ({_dmg_lvl} * 0.04))

		set {_life_lvl} to {cs_perk_lifesteal::%{_att_uuid}%} ? 0
		if {_life_lvl} > 0:
			set {_heal_amt} to damage * ({_life_lvl} * 0.015)
			if {_heal_amt} > 0:
				heal attacker by {_heal_amt}
				set {_loc} to location of attacker
				execute console command "particle minecraft:heart %x-coord of {_loc}% %y-coord of {_loc} + 2% %z-coord of {_loc}% 0.2 0.2 0.2 0.01 3 force"

	# Victim Defense Damage Reduction
	if victim is a player:
		set {_vic_uuid} to uuid of victim
		set {_def_lvl} to {cs_perk_defense::%{_vic_uuid}%} ? 0
		if {_def_lvl} > 0:
			set damage to damage * (1 - ({_def_lvl} * 0.03))

# ============================================================================
# VISUAL PARTICLE AURA LOOP (DYNAMIC SERVER CONFIG CHECK)
# ============================================================================

every 1 second:
	if is_cs_aura_enabled() is false:
		stop
	loop all players:
		set {_p} to loop-value
		set {_uuid} to uuid of {_p}
		set {_cs} to {chuyensinh::%{_uuid}%} ? 0
		if {_cs} >= 1:
			if {cs_aura_toggle::%{_uuid}%} is not false:
				set {_loc} to location of {_p}
				set {_x} to x-coord of {_loc}
				set {_y} to y-coord of {_loc} + 1
				set {_z} to z-coord of {_loc}
				if {_cs} >= 10:
					execute console command "particle minecraft:dragon_breath %{_x}% %{_y}% %{_z}% 0.3 0.6 0.3 0.02 12 force"
					execute console command "particle minecraft:end_rod %{_x}% %{_y}% %{_z}% 0.2 0.4 0.2 0.02 6 force"
				else if {_cs} >= 5:
					execute console command "particle minecraft:soul_fire_flame %{_x}% %{_y}% %{_z}% 0.25 0.5 0.25 0.02 8 force"
				else:
					execute console command "particle minecraft:flame %{_x}% %{_y}% %{_z}% 0.25 0.5 0.25 0.02 8 force"

# ============================================================================
# MMOCORE BONUS EXP LISTENER
# ============================================================================

on PlayerExperienceGainEvent:
	set {_orig_exp} to event.getExperience()
	if {_orig_exp} <= 0:
		stop
	set {_p} to event.getPlayer()
	if {_p} is set:
		set {_uuid} to uuid of {_p}
		set {_cs} to {chuyensinh::%{_uuid}%} ? 0
		if {_cs} > 0:
			set {_exp_bonus} to get_cs_exp_bonus_per_level()
			event.setExperience({_orig_exp} * (1 + ({_cs} * {_exp_bonus})))
