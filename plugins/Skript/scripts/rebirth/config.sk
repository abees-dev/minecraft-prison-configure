# ============================================================================
# REBIRTH SYSTEM CONFIGURATION
# File: plugins/Skript/scripts/rebirth/config.sk
# ============================================================================

# Dynamic Particle Aura Server-Wide Toggle
function is_cs_aura_enabled() :: boolean:
	if {cs_system_aura_enabled} is set:
		return {cs_system_aura_enabled}
	return true # Default enabled server-wide

function get_cs_max_level() :: number:
	return 20 # Maximum Rebirth Level Cap (20)

function get_cs_gui_title() :: text:
	return "&8[✦] &d&lCHUYỂN SINH &8❖ &e&lCÂY KỸ NĂNG &8[✦]"

function get_cs_req_rank() :: number:
	return 9 # Required Rank 9 [Vượt Ngục]

function get_cs_req_level() :: number:
	return 100 # Required MMOCore Level 100

function get_cs_req_money() :: number:
	return 100000000 # Required $100,000,000 Money

function get_cs_points_per_rebirth() :: number:
	return 3 # Rebirth Skill Points awarded per Rebirth

function get_cs_exp_bonus_per_level() :: number:
	return 0.05 # Bonus +5% MMOCore EXP per Rebirth level

function get_cs_prefix(cs_lvl: number) :: text:
	if {_cs_lvl} >= 20:
		return "&4&l🔥%{_cs_lvl}% "
	if {_cs_lvl} >= 10:
		return "&d&l👑%{_cs_lvl}% "
	if {_cs_lvl} >= 5:
		return "&b&l⚡%{_cs_lvl}% "
	if {_cs_lvl} >= 3:
		return "&e&l★%{_cs_lvl}% "
	return "&c&l❖%{_cs_lvl}% "
