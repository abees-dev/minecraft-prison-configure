# =======================================================
# Skript: Give Tất Cả Hòm Đá Quý (ExcellentCrates)
# File: plugins/Skript/scripts/admin/give_all_hom.sk
# Command: /giveallhom [<player>] [<number>]
# Aliases: /giveallcrate, /givehom
# =======================================================

command /giveallhom [<player>] [<number=1>]:
    aliases: /giveallcrate, /givehom
    permission: op
    permission message: &cBạn không có quyền sử dụng lệnh này!
    trigger:
        set {_target} to player
        if arg-1 is set:
            set {_target} to arg-1
        
        set {_amount} to arg-2
        if {_amount} <= 0:
            set {_amount} to 1
            
        execute console command "crate give %{_target}% ruong_hong_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_lam_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_luc_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_hoang_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_tu_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_bang_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_hac_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_bach_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_tho_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_cam_ngoc %{_amount}%"
        execute console command "crate give %{_target}% ruong_da_quy_tong_hop %{_amount}%"
        
        send "&a[Crates] &fĐã nhận thành công &e%{_amount}%x &fcho tất cả 11 loại Hòm Đá Quý!" to {_target}
        if {_target} is not player:
            send "&a[Crates] &fĐã phát &e%{_amount}%x &ftất cả 11 loại Hòm Đá Quý cho người chơi &b%{_target}%&f!" to player
