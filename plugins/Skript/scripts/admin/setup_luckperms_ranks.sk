# =============================================================================
# HỆ THỐNG SETUP TỰ ĐỘNG LUCKPERMS RANKS - Admin Tool
# File: plugins/Skript/scripts/admin/setup_luckperms_ranks.sk
# Lệnh: /setuplpranks hoặc /setup-lp-ranks
# 2026-08-01: bỏ EconomyShopGUI sell-multiplier; prison ranks thừa kế lệnh;
#             home-rank khớp Essentials sethome-multiple.
# =============================================================================

command /setuplpranks:
	permission: op
	permission message: &cBạn không có quyền thực thi lệnh này!
	trigger:
		send "&6&l[LuckPerms Setup] &eBắt đầu khởi tạo hệ thống Rank Prison & VIP..." to sender
		
		# =============================================================================
		# PART 1: PRISON RANKS (1 -> 9)
		# =============================================================================
		send "&7[1/4] Đang tạo 9 Group Rank Prison..." to sender
		execute console command "lp creategroup xprison_rank_1"
		execute console command "lp creategroup xprison_rank_2"
		execute console command "lp creategroup xprison_rank_3"
		execute console command "lp creategroup xprison_rank_4"
		execute console command "lp creategroup xprison_rank_5"
		execute console command "lp creategroup xprison_rank_6"
		execute console command "lp creategroup xprison_rank_7"
		execute console command "lp creategroup xprison_rank_8"
		execute console command "lp creategroup xprison_rank_9"
		
		execute console command "lp createtrack prision_ranks"
		execute console command "lp track prision_ranks append xprison_rank_1"
		execute console command "lp track prision_ranks append xprison_rank_2"
		execute console command "lp track prision_ranks append xprison_rank_3"
		execute console command "lp track prision_ranks append xprison_rank_4"
		execute console command "lp track prision_ranks append xprison_rank_5"
		execute console command "lp track prision_ranks append xprison_rank_6"
		execute console command "lp track prision_ranks append xprison_rank_7"
		execute console command "lp track prision_ranks append xprison_rank_8"
		execute console command "lp track prision_ranks append xprison_rank_9"
		
		# Rank 1 thừa kế default (X-Prison dùng "parent set" → player mất group default)
		execute console command "lp group xprison_rank_1 parent add default"
		# Thừa kế: rank cao giữ toàn bộ command bonus rank thấp
		execute console command "lp group xprison_rank_2 parent add xprison_rank_1"
		execute console command "lp group xprison_rank_3 parent add xprison_rank_2"
		execute console command "lp group xprison_rank_4 parent add xprison_rank_3"
		execute console command "lp group xprison_rank_5 parent add xprison_rank_4"
		execute console command "lp group xprison_rank_6 parent add xprison_rank_5"
		execute console command "lp group xprison_rank_7 parent add xprison_rank_6"
		execute console command "lp group xprison_rank_8 parent add xprison_rank_7"
		execute console command "lp group xprison_rank_9 parent add xprison_rank_8"
		
		execute console command "lp group xprison_rank_1 setweight 1"
		execute console command "lp group xprison_rank_2 setweight 2"
		execute console command "lp group xprison_rank_3 setweight 3"
		execute console command "lp group xprison_rank_4 setweight 4"
		execute console command "lp group xprison_rank_5 setweight 5"
		execute console command "lp group xprison_rank_6 setweight 6"
		execute console command "lp group xprison_rank_7 setweight 7"
		execute console command "lp group xprison_rank_8 setweight 8"
		execute console command "lp group xprison_rank_9 setweight 9"
		
		execute console command "lp group xprison_rank_1 meta setprefix 1 '<white><bold>[Tân Binh]</bold></white> '"
		execute console command "lp group xprison_rank_2 meta setprefix 2 '<gray><bold>[Tù Nhân]</bold></gray> '"
		execute console command "lp group xprison_rank_3 meta setprefix 3 '<green><bold>[Lao Công]</bold></green> '"
		execute console command "lp group xprison_rank_4 meta setprefix 4 '<dark_green><bold>[Thợ Đào]</bold></dark_green> '"
		execute console command "lp group xprison_rank_5 meta setprefix 5 '<aqua><bold>[Đội Trưởng]</bold></aqua> '"
		execute console command "lp group xprison_rank_6 meta setprefix 6 '<blue><bold>[Phó Quản Ngục]</bold></blue> '"
		execute console command "lp group xprison_rank_7 meta setprefix 7 '<light_purple><bold>[Quản Ngục]</bold></light_purple> '"
		execute console command "lp group xprison_rank_8 meta setprefix 8 '<gold><bold>[Bá Chủ Ngục Tù]</bold></gold> '"
		execute console command "lp group xprison_rank_9 meta setprefix 9 '<red><bold>[Vượt Ngục]</bold></red> '"
		
		send "&7[2/4] Đang gán command bonus Prison (không sell-multiplier ESG)..." to sender
		execute console command "lp group default permission set deluxemenus.open true"
		execute console command "lp group default permission set deluxemenus.menu.ranks_master true"
		execute console command "lp group default permission set deluxemenus.menu.warp_main true"
		execute console command "lp group default permission set deluxemenus.menu.warp_mines true"
		execute console command "lp group default permission set deluxemenus.menu.warp_dungeons true"
		execute console command "lp group default permission set deluxemenus.menu.warp_hub true"
		execute console command "lp group default permission set essentials.warp true"
		execute console command "lp group default permission set essentials.spawn true"
		execute console command "lp group default permission set essentials.kit true"
		execute console command "lp group default permission set essentials.balance true"
		
		execute console command "lp group default permission set xprison.ranks false"
		execute console command "lp group default permission set xprison.ranks.ranks false"
		
		# Rank 1: Tân Binh — 1 kho, 2 home, kit tân binh
		execute console command "lp group xprison_rank_1 permission set playervaults.amount.1 true"
		execute console command "lp group xprison_rank_1 permission set essentials.sethome.multiple true"
		execute console command "lp group xprison_rank_1 permission set essentials.sethome.multiple.rank1 true"
		execute console command "lp group xprison_rank_1 permission set essentials.kits.tanbinh true"

		
		# Rank 2: Tù Nhân — /workbench
		execute console command "lp group xprison_rank_2 permission set essentials.workbench true"
		
		# Rank 3: Lao Công — 2 kho, 3 home, /feed
		execute console command "lp group xprison_rank_3 permission set playervaults.amount.2 true"
		execute console command "lp group xprison_rank_3 permission set essentials.sethome.multiple.rank3 true"
		execute console command "lp group xprison_rank_3 permission set essentials.feed true"
		
		# Rank 4: Thợ Đào — /anvil
		execute console command "lp group xprison_rank_4 permission set essentials.anvil true"
		
		# Rank 5: Đội Trưởng — 3 kho, 4 home, /enderchest
		execute console command "lp group xprison_rank_5 permission set playervaults.amount.3 true"
		execute console command "lp group xprison_rank_5 permission set essentials.sethome.multiple.rank5 true"
		execute console command "lp group xprison_rank_5 permission set essentials.enderchest true"
		
		# Rank 6: Phó Quản Ngục — /heal
		execute console command "lp group xprison_rank_6 permission set essentials.heal true"
		
		# Rank 7: Quản Ngục — 4 kho, 5 home, /craft, /recipe
		execute console command "lp group xprison_rank_7 permission set playervaults.amount.4 true"
		execute console command "lp group xprison_rank_7 permission set essentials.sethome.multiple.rank7 true"
		execute console command "lp group xprison_rank_7 permission set essentials.craft true"
		execute console command "lp group xprison_rank_7 permission set essentials.recipe true"
		
		# Rank 8: Bá Chủ — /pweather
		execute console command "lp group xprison_rank_8 permission set essentials.pweather true"
		
		# Rank 9: Vượt Ngục — 5 kho, 6 home, /ptime, kit
		execute console command "lp group xprison_rank_9 permission set playervaults.amount.5 true"
		execute console command "lp group xprison_rank_9 permission set essentials.sethome.multiple.rank9 true"
		execute console command "lp group xprison_rank_9 permission set essentials.ptime true"
		execute console command "lp group xprison_rank_9 permission set essentials.kits.rank9 true"
		
		# =============================================================================
		# PART 2: VIP DONOR RANKS (1 -> 6)
		# =============================================================================
		send "&7[3/4] Đang tạo 6 Group Rank VIP & cấu hình Thừa Kế..." to sender
		execute console command "lp creategroup vip"
		execute console command "lp creategroup vipplus"
		execute console command "lp creategroup mvp"
		execute console command "lp creategroup mvpplus"
		execute console command "lp creategroup elite"
		execute console command "lp creategroup legend"
		
		execute console command "lp group vip parent add default"
		execute console command "lp group vipplus parent add vip"
		execute console command "lp group mvp parent add vipplus"
		execute console command "lp group mvpplus parent add mvp"
		execute console command "lp group elite parent add mvpplus"
		execute console command "lp group legend parent add elite"
		
		execute console command "lp createtrack vip_donors"
		execute console command "lp track vip_donors append vip"
		execute console command "lp track vip_donors append vipplus"
		execute console command "lp track vip_donors append mvp"
		execute console command "lp track vip_donors append mvpplus"
		execute console command "lp track vip_donors append elite"
		execute console command "lp track vip_donors append legend"
		
		execute console command "lp group vip setweight 10"
		execute console command "lp group vipplus setweight 20"
		execute console command "lp group mvp setweight 30"
		execute console command "lp group mvpplus setweight 40"
		execute console command "lp group elite setweight 50"
		execute console command "lp group legend setweight 60"
		
		execute console command "lp group vip meta setprefix 100 '<green><bold>[VIP]</bold></green> '"
		execute console command "lp group vipplus meta setprefix 100 '<dark_aqua><bold>[VIP+]</bold></dark_aqua> '"
		execute console command "lp group mvp meta setprefix 100 '<aqua><bold>[MVP]</bold></aqua> '"
		execute console command "lp group mvpplus meta setprefix 100 '<light_purple><bold>[MVP+]</bold></light_purple> '"
		execute console command "lp group elite meta setprefix 100 '<gold><bold>[ELITE]</bold></gold> '"
		execute console command "lp group legend meta setprefix 100 '<gradient:#FF5555:#FFD700><bold>[LEGEND]</bold></gradient> '"
		
		send "&7[4/4] Đang gán command bonus VIP (không sell-multiplier ESG)..." to sender
		# VIP — 6 kho, 5 home, /workbench, /hat, kit (không /fly — fly ở LEGEND)
		execute console command "lp group vip permission set playervaults.amount.6 true"
		execute console command "lp group vip permission set essentials.sethome.multiple true"
		execute console command "lp group vip permission set essentials.sethome.multiple.vip true"
		execute console command "lp group vip permission set essentials.kits.vip true"
		execute console command "lp group vip permission set essentials.workbench true"
		execute console command "lp group vip permission set essentials.hat true"
		
		# VIP+ — 8 kho, 7 home, /enderchest, chat màu, kit
		execute console command "lp group vipplus permission set playervaults.amount.8 true"
		execute console command "lp group vipplus permission set essentials.sethome.multiple.vipplus true"
		execute console command "lp group vipplus permission set essentials.kits.vipplus true"
		execute console command "lp group vipplus permission set essentials.enderchest true"
		execute console command "lp group vipplus permission set essentials.chat.color true"
		
		# MVP — 10 kho, 10 home, /heal, /feed, kit
		execute console command "lp group mvp permission set playervaults.amount.10 true"
		execute console command "lp group mvp permission set essentials.sethome.multiple.mvp true"
		execute console command "lp group mvp permission set essentials.kits.mvp true"
		execute console command "lp group mvp permission set essentials.heal true"
		execute console command "lp group mvp permission set essentials.feed true"
		
		# MVP+ — 12 kho, 15 home, /nick, /repair, /anvil, kit
		execute console command "lp group mvpplus permission set playervaults.amount.12 true"
		execute console command "lp group mvpplus permission set essentials.sethome.multiple.mvpplus true"
		execute console command "lp group mvpplus permission set essentials.kits.mvpplus true"
		execute console command "lp group mvpplus permission set essentials.nick true"
		execute console command "lp group mvpplus permission set essentials.repair true"
		execute console command "lp group mvpplus permission set essentials.anvil true"
		
		# ELITE — 16 kho, 20 home, /speed, kit
		execute console command "lp group elite permission set playervaults.amount.16 true"
		execute console command "lp group elite permission set essentials.sethome.multiple.elite true"
		execute console command "lp group elite permission set essentials.kits.elite true"
		execute console command "lp group elite permission set essentials.speed true"
		
		# LEGEND — 20 kho, 25 home, /fly (+ KeepFly), disguise, /ptime, /pweather, kit
		execute console command "lp group legend permission set playervaults.amount.20 true"
		execute console command "lp group legend permission set essentials.sethome.multiple.legend true"
		execute console command "lp group legend permission set essentials.kits.legend true"
		execute console command "lp group legend permission set essentials.fly true"
		execute console command "lp group legend permission set xprison.fly.keep true"
		execute console command "lp group legend permission set libsdisguises.seecmd.disguise true"
		execute console command "lp group legend permission set libsdisguises.seecmd.undisguise true"
		execute console command "lp group legend permission set disguise.* true"
		execute console command "lp group legend permission set essentials.ptime true"
		execute console command "lp group legend permission set essentials.pweather true"
		
		send "&a&l[LuckPerms Setup] ✔ Xong — command bonus theo rank (sell mult chỉ Bang Hội)!" to sender
		send "&eNhắc: Essentials sethome-multiple đã có rank1/3/5/7/9 — /ess reload nếu vừa sửa file." to sender
		
command /setup-lp-ranks:
	permission: op
	permission message: &cBạn không có quyền thực thi lệnh này!
	trigger:
		execute console command "setuplpranks"
