import:
	io.lumine.mythic.lib.api.item.NBTItem
	net.Indyuce.mmoitems.MMOItems
	net.Indyuce.mmoitems.ItemStats
	net.Indyuce.mmoitems.api.item.mmoitem.LiveMMOItem
	net.Indyuce.mmoitems.stat.data.UpgradeData

# ============================================================================
# EQUIPMENT UPGRADE MAIN SYSTEM
# File: plugins/Skript/scripts/upgrade/main.sk
# Main Commands: /cuonghoa, /nangcap, /upgrade
# ============================================================================

command /cuonghoa:
	aliases: /nangcap, /upgrade
	trigger:
		open_cuonghoa_gui(player)

function open_cuonghoa_gui(p: player):
	set {_title} to get_cuonghoa_gui_title()
	set {_inv} to a new chest inventory with 6 rows named {_title}
	
	# Filler kính xám
	loop 54 times:
		set {_slot} to loop-number - 1
		if {_slot} is not 19 or 22 or 25 or 31 or 49:
			set slot {_slot} of {_inv} to gray stained glass pane named "&7"

	# Slot 19: Ô Đặt Trang Bị
	set slot 19 of {_inv} to anvil named "&e&lÔ ĐẶT TRANG BỊ" with lore "&7Hãy kéo Vũ Khí hoặc Áo Giáp", "&7cần cường hóa đặt vào ô này."

	# Slot 25: Ô Đặt Đá Cường Hóa
	set slot 25 of {_inv} to emerald named "&e&lÔ ĐẶT ĐÁ CƯỜNG HÓA" with lore "&7Hãy đặt Đá Cường Hóa", "&7phù hợp vào ô này."

	# Slot 22: Thông Tin Xem Trước
	set slot 22 of {_inv} to nether star named "&b&lTHÔNG TIN CƯỜNG HÓA" with lore "&7Đặt Trang Bị & Đá Cường Hóa", "&7vào 2 ô bên cạnh rồi bấm &a[CƯỜNG HÓA]&7."

	# Slot 31: Nút Cường Hóa
	set slot 31 of {_inv} to smithing table named "&a&l[ CƯỜNG HÓA TRANG BỊ ]" with lore "&7Click để bắt đầu tiến trình cường hóa!"

	# Slot 49: Nút Đóng GUI
	set slot 49 of {_inv} to barrier named "&c&lĐÓNG GIAO DIỆN" with lore "&7Click để đóng menu & nhận lại vật phẩm."

	open {_inv} to {_p}

# ============================================================================
# GUI CLICK EVENTS & ITEM PROTECTION
# ============================================================================
on inventory click:
	set {_title} to get_cuonghoa_gui_title()
	if name of top inventory of player contains {_title}:
		if clicked inventory is top inventory of player:
			set {_slot} to index of clicked slot

			# Slot 49: Close GUI
			if {_slot} is 49:
				cancel event
				close inventory of player
				stop

			# Slot 31: Process Upgrade
			if {_slot} is 31:
				cancel event
				process_cuong_hoa(player)
				stop

			# Slot 22: Info Item
			if {_slot} is 22:
				cancel event
				stop

			# Slot 19: Equipment Slot
			if {_slot} is 19:
				set {_item} to slot 19 of top inventory of player
				if name of {_item} contains "Ô ĐẶT TRANG BỊ":
					set slot 19 of top inventory of player to air
				stop

			# Slot 25: Stone Slot
			if {_slot} is 25:
				set {_stone} to slot 25 of top inventory of player
				if name of {_stone} contains "Ô ĐẶT ĐÁ CƯỜNG HÓA":
					set slot 25 of top inventory of player to air
				stop

			cancel event

		else:
			if "%click type%" contains "shift":
				cancel event

# ============================================================================
# ANTI-DUPE ITEM RETURN ON GUI CLOSE
# ============================================================================
on inventory close:
	set {_title} to get_cuonghoa_gui_title()
	if name of event-inventory contains {_title}:
		set {_item} to slot 19 of event-inventory
		set {_stone} to slot 25 of event-inventory
		
		if {_item} is set:
			if {_item} is not air:
				if name of {_item} does not contain "Ô ĐẶT TRANG BỊ":
					give {_item} to player
					set slot 19 of event-inventory to air
				
		if {_stone} is set:
			if {_stone} is not air:
				if name of {_stone} does not contain "Ô ĐẶT ĐÁ CƯỜNG HÓA":
					give {_stone} to player
					set slot 25 of event-inventory to air

# ============================================================================
# PROCESS UPGRADE LOGIC
# ============================================================================
function process_cuong_hoa(p: player):
	set {_inv} to current inventory of {_p}
	set {_item} to slot 19 of {_inv}
	set {_stone} to slot 25 of {_inv}

	if {_item} is not set:
		send get_cuonghoa_msg("NO_ITEM") to {_p}
		stop
	if {_item} is air:
		send get_cuonghoa_msg("NO_ITEM") to {_p}
		stop
	if name of {_item} contains "Ô ĐẶT TRANG BỊ":
		send get_cuonghoa_msg("NO_ITEM") to {_p}
		stop

	set {_item_nbt} to try NBTItem.get({_item})
	if {_item_nbt} is not set:
		send get_cuonghoa_msg("INVALID_ITEM") to {_p}
		stop

	set {_item_type} to try {_item_nbt}.getString("MMOITEMS_ITEM_TYPE")
	set {_item_id} to try {_item_nbt}.getString("MMOITEMS_ITEM_ID")
	if {_item_type} is not set:
		send get_cuonghoa_msg("NOT_MMOITEM") to {_p}
		stop

	set {_cur_lvl} to 0
	set {_check_live} to try new LiveMMOItem({_item})
	if {_check_live} is set:
		if {_check_live}.hasData(ItemStats.UPGRADE) is true:
			set {_upg_data_check} to {_check_live}.getData(ItemStats.UPGRADE)
			set {_cur_lvl} to {_upg_data_check}.getLevel()

	if {_cur_lvl} >= 100:
		send get_cuonghoa_msg("MAX_LEVEL") to {_p}
		stop

	if {_stone} is not set:
		send get_cuonghoa_msg("NO_STONE") to {_p}
		stop
	if {_stone} is air:
		send get_cuonghoa_msg("NO_STONE") to {_p}
		stop
	if name of {_stone} contains "Ô ĐẶT ĐÁ CƯỜNG HÓA":
		send get_cuonghoa_msg("NO_STONE") to {_p}
		stop

	set {_stone_nbt} to try NBTItem.get({_stone})
	if {_stone_nbt} is not set:
		send get_cuonghoa_msg("INVALID_STONE") to {_p}
		stop

	set {_stone_id} to try {_stone_nbt}.getString("MMOITEMS_ITEM_ID")
	if {_stone_id} is not set:
		send get_cuonghoa_msg("INVALID_STONE") to {_p}
		stop

	set {_is_weapon} to false
	set {_is_armor} to false

	if {_item_type} is "SWORD" or "AXE" or "STAFF" or "DAGGER" or "BOW" or "CROSSBOW" or "HAMMER" or "GAUNTLET" or "MUSKET" or "SPEAR" or "TOOL":
		set {_is_weapon} to true
	else if {_item_type} is "ARMOR" or "HELMET" or "CHESTPLATE" or "LEGGINGS" or "BOOTS" or "SHIELD" or "ACCESSORY" or "RING" or "AMULET" or "BRACELET" or "GLOVES":
		set {_is_armor} to true

	if {_is_weapon} is false:
		if {_is_armor} is false:
			send get_cuonghoa_msg("UNSUPPORTED_TYPE", {_item_type}) to {_p}
			stop

	set {_success_rate} to get_cuonghoa_success_rate({_stone_id}, {_is_weapon}, {_is_armor}, {_cur_lvl})

	if {_success_rate} < 0:
		set {_lvl_str} to "%{_cur_lvl}%"
		send get_cuonghoa_msg("MISMATCH_STONE", {_lvl_str}) to {_p}
		stop

	set {_stone_amt} to amount of {_stone}
	if {_stone_amt} > 1:
		set amount of slot 25 of {_inv} to ({_stone_amt} - 1)
	else:
		set slot 25 of {_inv} to air

	set {_roll} to a random integer between 1 and 100
	if {_roll} <= {_success_rate}:
		set {_next_lvl} to {_cur_lvl} + 1
		set {_live_item} to try new LiveMMOItem({_item})
		if {_live_item} is set:
			if {_live_item}.hasData(ItemStats.UPGRADE) is true:
				set {_upg_data} to {_live_item}.getData(ItemStats.UPGRADE)
				{_upg_data}.upgrade({_live_item})
			else:
				set {_template_id} to "weapon-upgrade-template"
				if {_is_armor} is true:
					set {_template_id} to "armor-upgrade-template"
				set {_template} to try MMOItems.plugin.getUpgrades().getTemplate({_template_id})
				if {_template} is set:
					{_template}.upgrade({_live_item})

			set {_upgraded_item} to {_live_item}.newBuilder().build()
			set slot 19 of {_inv} to {_upgraded_item}

		play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}
		play sound "block.anvil.use" with volume 1 and pitch 1.2 to {_p}
		set {_next_str} to "%{_next_lvl}%"
		send get_cuonghoa_msg("SUCCESS", {_next_str}) to {_p}
	else:
		play sound "entity.item.break" with volume 1 and pitch 0.8 to {_p}
		set {_cur_str} to "%{_cur_lvl}%"
		send get_cuonghoa_msg("FAIL", {_cur_str}) to {_p}
