# ============================================================================
# EQUIPMENT UPGRADE CONFIGURATION
# File: plugins/Skript/scripts/upgrade/config.sk
# ============================================================================

function get_cuonghoa_msg(key: text, val1: text = "", val2: text = "") :: text:
	if {_key} is "SUCCESS":
		return "&a&l[✦] CƯỜNG HÓA THÀNH CÔNG! &7Trang bị đã được nâng cấp lên &e+%{_val1}%&7!"

	if {_key} is "FAIL":
		return "&c&l[-] CƯỜNG HÓA THẤT BẠI! &7Đã tiêu hao 1x Đá Cường Hóa, trang bị giữ nguyên cấp &e+%{_val1}%&7."

	if {_key} is "NO_ITEM":
		return "&c[!] Hãy đặt Trang Bị cần cường hóa vào ô bên trái!"

	if {_key} is "INVALID_ITEM":
		return "&c[!] Vật phẩm này không hợp lệ hoặc không có dữ liệu MMOItems!"

	if {_key} is "NOT_MMOITEM":
		return "&c[!] Trang bị này không phải là MMOItem hợp lệ!"

	if {_key} is "MAX_LEVEL":
		return "&e[!] Trang bị này đã đạt Cấp Cường Hóa Tối Đa (LV 100)!"

	if {_key} is "NO_STONE":
		return "&c[!] Hãy đặt Đá Cường Hóa (MATERIAL) vào ô bên phải!"

	if {_key} is "INVALID_STONE":
		return "&c[!] Vật phẩm đá không phải Đá Cường Hóa hợp lệ!"

	if {_key} is "UNSUPPORTED_TYPE":
		return "&c[!] Loại trang bị '%{_val1}%' không hỗ trợ cường hóa!"

	if {_key} is "MISMATCH_STONE":
		return "&c[!] Đá cường hóa không phù hợp với trang bị hoặc cấp độ hiện tại (Cấp %{_val1}%)!"

	return ""

function get_cuonghoa_gui_title() :: text:
	return "&8[&c✦&8] &c&lCƯỜNG HÓA TRANG BỊ"

function get_cuonghoa_success_rate(stone_id: text, is_weapon: boolean, is_armor: boolean, cur_lvl: number) :: number:
	if {_stone_id} is "DA_CUONG_HOA_THIEN_MENH":
		if {_cur_lvl} is between 0 and 99:
			return 100

	if {_is_weapon} is true:
		if {_stone_id} does not contain "_VU_KHI_":
			return -1
	else if {_is_armor} is true:
		if {_stone_id} does not contain "_GIAP_":
			return -1

	if {_stone_id} contains "SO_CAP":
		if {_cur_lvl} is between 0 and 19:
			return 85
	else if {_stone_id} contains "TRUNG_CAP":
		if {_cur_lvl} is between 20 and 39:
			return 65
	else if {_stone_id} contains "CAO_CAP":
		if {_cur_lvl} is between 40 and 59:
			return 45
	else if {_stone_id} contains "SIEU_CAP":
		if {_cur_lvl} is between 60 and 79:
			return 25
	else if {_stone_id} contains "HUYEN_THOAI":
		if {_cur_lvl} is between 80 and 99:
			return 10

	return -1
