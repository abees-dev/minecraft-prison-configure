import:
	io.lumine.mythic.lib.api.item.NBTItem
	net.Indyuce.mmoitems.api.item.mmoitem.LiveMMOItem
	net.Indyuce.mmoitems.ItemStats
	net.Indyuce.mmoitems.stat.data.GemSocketsData
	java.util.ArrayList

# ============================================================================
# EQUIPMENT SOCKET PUNCH MAIN SYSTEM
# File: plugins/Skript/scripts/sockets/main.sk
# Main Commands: /duclo, /socket, /duc
# ============================================================================

command /duclo:
	aliases: /socket, /duc
	trigger:
		open_duclo_gui(player)

function open_duclo_gui(p: player):
	set {_title} to get_duclo_gui_title()
	set {_inv} to a new chest inventory with 6 rows named {_title}
	
	# Filler kính xám
	loop 54 times:
		set {_slot} to loop-number - 1
		if {_slot} is not 19 or 22 or 25 or 31 or 49:
			set slot {_slot} of {_inv} to gray stained glass pane named "&7"

	# Slot 19: Ô Đặt Trang Bị
	set slot 19 of {_inv} to anvil named "&e&lÔ ĐẶT TRANG BỊ" with lore "&7Hãy kéo Vũ Khí hoặc Áo Giáp", "&7cần đục lỗ đặt vào ô này."

	# Slot 25: Ô Đặt Đá Đục Lỗ
	set slot 25 of {_inv} to diamond named "&b&lÔ ĐẶT ĐÁ ĐỤC LỖ" with lore "&7Hãy đặt Đá Đục Lỗ", "&7phù hợp vào ô này."

	# Slot 22: Thông Tin Xem Trước
	set slot 22 of {_inv} to nether star named "&b&lTHÔNG TIN ĐỤC LỖ" with lore "&7Đặt Trang Bị & Đá Đục Lỗ", "&7vào 2 ô bên cạnh rồi bấm &a[ĐỤC LỖ]&7."

	# Slot 31: Nút Đục Lỗ
	set slot 31 of {_inv} to smithing table named "&a&l[ XÁC NHẬN ĐỤC LỖ ]" with lore "&7Click để tiến hành đục lỗ ô khảm!"

	# Slot 49: Nút Đóng GUI
	set slot 49 of {_inv} to barrier named "&c&lĐÓNG GIAO DIỆN" with lore "&7Click để đóng menu & nhận lại vật phẩm."

	open {_inv} to {_p}

# ============================================================================
# GUI CLICK EVENTS & ITEM PROTECTION
# ============================================================================
on inventory click:
	set {_title} to get_duclo_gui_title()
	if name of top inventory of player contains {_title}:
		if clicked inventory is top inventory of player:
			set {_slot} to index of clicked slot

			# Slot 49: Close GUI
			if {_slot} is 49:
				cancel event
				close inventory of player
				stop

			# Slot 31: Process Socket Punch
			if {_slot} is 31:
				cancel event
				process_duc_lo(player)
				stop

			# Slot 22: Info
			if {_slot} is 22:
				cancel event
				stop

			# Slot 19: Equipment Slot
			if {_slot} is 19:
				set {_item} to slot 19 of top inventory of player
				if name of {_item} contains "Ô ĐẶT TRANG BỊ":
					set slot 19 of top inventory of player to air
				stop

			# Slot 25: Stone Slot
			if {_slot} is 25:
				set {_stone} to slot 25 of top inventory of player
				if name of {_stone} contains "Ô ĐẶT ĐÁ ĐỤC LỖ":
					set slot 25 of top inventory of player to air
				stop

			cancel event

		else:
			if "%click type%" contains "shift":
				cancel event

# ============================================================================
# ANTI-DUPE ITEM RETURN ON GUI CLOSE
# ============================================================================
on inventory close:
	set {_title} to get_duclo_gui_title()
	if name of event-inventory contains {_title}:
		set {_item} to slot 19 of event-inventory
		set {_stone} to slot 25 of event-inventory
		
		if {_item} is set:
			if {_item} is not air:
				if name of {_item} does not contain "Ô ĐẶT TRANG BỊ":
					give {_item} to player
					set slot 19 of event-inventory to air
				
		if {_stone} is set:
			if {_stone} is not air:
				if name of {_stone} does not contain "Ô ĐẶT ĐÁ ĐỤC LỖ":
					give {_stone} to player
					set slot 25 of event-inventory to air

# ============================================================================
# PROCESS SOCKET PUNCH LOGIC
# ============================================================================
function process_duc_lo(p: player):
	set {_inv} to current inventory of {_p}
	set {_item} to slot 19 of {_inv}
	set {_stone} to slot 25 of {_inv}

	if {_item} is not set:
		send get_duclo_msg("NO_ITEM") to {_p}
		stop
	if {_item} is air:
		send get_duclo_msg("NO_ITEM") to {_p}
		stop
	if name of {_item} contains "Ô ĐẶT TRANG BỊ":
		send get_duclo_msg("NO_ITEM") to {_p}
		stop

	set {_item_nbt} to try NBTItem.get({_item})
	if {_item_nbt} is not set:
		send get_duclo_msg("INVALID_ITEM") to {_p}
		stop

	set {_item_type} to try {_item_nbt}.getString("MMOITEMS_ITEM_TYPE")
	if {_item_type} is not set:
		send get_duclo_msg("NOT_MMOITEM") to {_p}
		stop

	if {_item_type} is "GEM_STONE" or "CONSUMABLE" or "MATERIAL" or "MISCELLANEOUS" or "TOOL":
		send get_duclo_msg("UNSUPPORTED_TYPE", {_item_type}) to {_p}
		stop

	set {_mmoitem} to try new LiveMMOItem({_item})
	if {_mmoitem} is not set:
		send get_duclo_msg("INVALID_ITEM") to {_p}
		stop

	set {_cur_sockets} to 0
	if {_mmoitem}.hasData(ItemStats.GEM_SOCKETS) is true:
		set {_socket_data} to {_mmoitem}.getData(ItemStats.GEM_SOCKETS)
		set {_empty_cnt} to {_socket_data}.getEmptySlots().size()
		set {_gems_cnt} to {_socket_data}.getGems().size()
		set {_cur_sockets} to {_empty_cnt} + {_gems_cnt}

	set {_max_sockets} to 0
	set {_custom_max} to try {_item_nbt}.getDouble("MMOITEMS_CUSTOM_MAXSOCKETS")
	if {_custom_max} is set:
		if {_custom_max} > 0:
			set {_max_sockets} to round({_custom_max})

	if {_max_sockets} <= 0:
		send get_duclo_msg("NOT_PUNCHABLE") to {_p}
		stop

	if {_cur_sockets} >= {_max_sockets}:
		set {_cur_str} to "%{_cur_sockets}%"
		set {_max_str} to "%{_max_sockets}%"
		send get_duclo_msg("MAX_SOCKETS_REACHED", {_cur_str}, {_max_str}) to {_p}
		stop

	if {_stone} is not set:
		send get_duclo_msg("NO_STONE") to {_p}
		stop
	if {_stone} is air:
		send get_duclo_msg("NO_STONE") to {_p}
		stop
	if name of {_stone} contains "Ô ĐẶT ĐÁ ĐỤC LỖ":
		send get_duclo_msg("NO_STONE") to {_p}
		stop

	set {_stone_nbt} to try NBTItem.get({_stone})
	if {_stone_nbt} is not set:
		send get_duclo_msg("INVALID_STONE") to {_p}
		stop

	set {_stone_id} to try {_stone_nbt}.getString("MMOITEMS_ITEM_ID")
	if {_stone_id} is not set:
		send get_duclo_msg("INVALID_STONE") to {_p}
		stop

	set {_rate} to get_socket_punch_rate({_stone_id}, {_cur_sockets})

	if {_rate} < 0:
		set {_cur_str} to "%{_cur_sockets}%"
		send get_duclo_msg("MISMATCH_STONE", {_cur_str}) to {_p}
		stop

	set {_stone_amt} to amount of {_stone}
	if {_stone_amt} > 1:
		set amount of slot 25 of {_inv} to ({_stone_amt} - 1)
	else:
		set slot 25 of {_inv} to air

	set {_roll} to a random integer between 1 and 100
	if {_roll} <= {_rate}:
		if {_mmoitem}.hasData(ItemStats.GEM_SOCKETS) is true:
			set {_socket_data} to {_mmoitem}.getData(ItemStats.GEM_SOCKETS)
		else:
			set {_empty_list} to new ArrayList()
			set {_socket_data} to new GemSocketsData({_empty_list})

		{_socket_data}.addEmptySlot("Uncolored")
		{_mmoitem}.setData(ItemStats.GEM_SOCKETS, {_socket_data})

		set {_builder} to {_mmoitem}.newBuilder()
		set {_punched_item} to {_builder}.build()
		set slot 19 of {_inv} to {_punched_item}

		play sound "block.anvil.use" with volume 1 and pitch 1.2 to {_p}
		play sound "entity.player.levelup" with volume 1 and pitch 1.5 to {_p}
		set {_next_socket} to "%{_cur_sockets} + 1%"
		send get_duclo_msg("SUCCESS", {_next_socket}) to {_p}
	else:
		play sound "entity.item.break" with volume 1 and pitch 0.8 to {_p}
		send get_duclo_msg("FAIL") to {_p}
