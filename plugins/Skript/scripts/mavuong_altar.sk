import:
	io.lumine.mythic.lib.api.item.NBTItem

# ==============================================================================
# BAN THO TRIEU HOI MA VUONG NGUC TU
# Dung Skript thay vi MythicMobs hasitem/holding vi 2 condition do co bug
# da xac nhan (GitLab issue #2033 "Holding and HasItem conditions always
# return false") tren ban MythicMobs 5.6.2 dang cai. Skript tu dem item
# qua NBT (giong pickaxe-upgrade.sk) roi tru bang lenh "mmoitems take"
# (da dung on dinh o file do), sau 3s delay moi goi console spawn boss
# MythicMobs qua "/mm mobs spawn".
#
# Ban tho la mob MythicMobs PRISON_MA_VUONG_ALTAR (ARMOR_STAND, xem
# mobs/altar_mobs.yml) dat tai world_magadungeon -2,80,86 (da ha xuong
# 1 block cho de click). Nhan dien qua ten hien thi (Display) chua
# "Ban Tho Trieu Hoi Ma Vuong". Da thu doi sang click khoi
# SCULK_SHRIEKER nhung Skript ban nay khong bat duoc event tren block do
# (khong ro nguyen nhan, co the do reach/hitbox/permission plugin khac) -
# quay lai cach ARMOR_STAND vi cach nay da xac nhan hoat dong truoc do.
#
# Chi can 1 HUY_HIEU_TRIEU_HOI (huy hieu that) de trieu hoi - item nay
# khong con roi truc tiep tu 9 boss nua, phai che tu
# MANH_HUY_HIEU_TRIEU_HOI (Huy Hieu Vo, roi 100% tu 9 boss). Cong thuc
# che se lam sau (chua co trong file nay).
#
# Cooldown 30 phut duoc dem bang so nguyen giay {mavuong_altar_cooldown_left}
# (KHONG dung Date/timespan roi convert "in seconds" vi Skript ban nay
# khong hieu cu phap do - "Can't understand this expression: {_x} in
# seconds"). Moi 5 giay tru 5 vao bien nay cho toi 0.
# ==============================================================================

on right click on armor stand:
	if name of event-entity does not contain "Bàn Thờ Triệu Hồi Ma Vương":
		stop trigger

	# Chong spam click / double-fire event (PlayerInteractEvent hay ban 2
	# lan cho main hand + off hand): moi player phai cho 5s giua 2 lan
	# trigger duoc xu ly, dung bien dem nguyen giay giong cooldown ben
	# duoi de tranh loi "in seconds" cua ban Skript nay.
	if {mavuong_altar_click_delay::%player's uuid%} is set:
		stop trigger
	set {mavuong_altar_click_delay::%player's uuid%} to 5

	if {mavuong_altar_cooldown_left} is set:
		if {mavuong_altar_cooldown_left} > 0:
			set {_min} to floor({mavuong_altar_cooldown_left} / 60)
			set {_sec} to {mavuong_altar_cooldown_left} - ({_min} * 60)
			send "&e&l[Bàn Thờ] &fMa Vương vừa được triệu hồi gần đây, hãy quay lại sau &c%{_min}% phút %{_sec}% giây&f!" to player
			stop trigger

	set {_count} to 0
	loop all items in player's inventory:
		if loop-value is not air:
			set {_realitem} to item in loop-value
			set {_nbt} to try NBTItem.get({_realitem})
			if {_nbt} is set:
				set {_id} to try {_nbt}.getString("MMOITEMS_ITEM_ID")
				if {_id} is "HUY_HIEU_TRIEU_HOI":
					add (amount of {_realitem}) to {_count}

	if {_count} < 1:
		send "&c&l[Bàn Thờ] &fBạn cần &e1 Huy Hiệu Triệu Hồi &f(chế từ Huy Hiệu Vỡ rớt ở 9 Boss trong Nhà Tù) để đánh thức Ma Vương!" to player
		stop trigger

	make console execute command "mmoitems take MATERIAL HUY_HIEU_TRIEU_HOI %player's name% 1"
	set {mavuong_altar_cooldown_left} to 1800
	send "&6&l[Bàn Thờ] &fHuy Hiệu Triệu Hồi đã phát sáng... Ma Vương Ngục Tù sắp thức tỉnh!" to player
	set {_summonplayer} to player
	wait 3 seconds
	make console execute command "mm mobs spawn PRISON_MA_VUONG_BOSS:10 1 world_magadungeon,-2,81,86"
	if {_summonplayer} is online:
		send "&4&l[TRÙM CUỐI] &fMa Vương Ngục Tù đã xuất hiện!" to {_summonplayer}

# Giam dan bien chong spam click {mavuong_altar_click_delay::%uuid%} moi
# giay, xoa khi ve 0 de player duoc click lai.
every 1 second:
	loop {mavuong_altar_click_delay::*}:
		set {_left} to loop-value - 1
		if {_left} <= 0:
			delete {mavuong_altar_click_delay::%loop-index%}
		else:
			set {mavuong_altar_click_delay::%loop-index%} to {_left}

# Tu cap nhat dong 2 cua hologram MaVuongTimer moi 5 giay theo bien
# {mavuong_altar_cooldown_left} (so nguyen giay con lai) - dung lenh
# "/dh line set <holo> <page> <line> <text>" cua DecentHolograms vi
# Skript khong co placeholder rieng doc duoc bien global cua chinh no.
every 5 seconds:
	if {mavuong_altar_cooldown_left} is not set:
		make console execute command "dh line set MaVuongTimer 1 2 &aSẵn sàng - Click chuột phải để triệu hồi!"
		stop trigger

	if {mavuong_altar_cooldown_left} <= 0:
		make console execute command "dh line set MaVuongTimer 1 2 &aSẵn sàng - Click chuột phải để triệu hồi!"
		stop trigger

	subtract 5 from {mavuong_altar_cooldown_left}
	if {mavuong_altar_cooldown_left} <= 0:
		set {mavuong_altar_cooldown_left} to 0
		make console execute command "dh line set MaVuongTimer 1 2 &aSẵn sàng - Click chuột phải để triệu hồi!"
		stop trigger

	set {_min} to floor({mavuong_altar_cooldown_left} / 60)
	set {_sec} to {mavuong_altar_cooldown_left} - ({_min} * 60)
	make console execute command "dh line set MaVuongTimer 1 2 &7Có thể triệu hồi lại sau: &c%{_min}% phút %{_sec}% giây"
