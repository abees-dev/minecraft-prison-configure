import:
	io.lumine.mythic.lib.api.item.NBTItem

# Bang du lieu nang cap cuoc Prison, tao khi script load.
# pickaxe_next::<id hien tai>       = id cap ke tiep
# pickaxe_stoneid::<id hien tai>    = id Da Nang Cap dung rank (khong doi theo buoc)
# pickaxe_stonecost::<id hien tai>  = so Da Nang Cap can cho buoc nay (8/16/32/64)
# pickaxe_moneycost::<id hien tai>  = tien Vault can cho buoc nay (% gia rank-up)
# pickaxe_success::<id hien tai>    = ti le thanh cong % (70/50/30/15)
#
# QUAN TRONG: that bai chi mat tien + da, KHONG mat cuoc dang cam (theo yeu cau
# nguoi dung "chi mat nl va tien"). Cuoc chi bi thu hoi khi THANH CONG (de doi
# sang cuoc cap moi).
on script load:
	set {_ranks::1} to "TAN_BINH"
	set {_bases::1} to 5000
	set {_ranks::2} to "TU_NHAN"
	set {_bases::2} to 10000
	set {_ranks::3} to "LAO_CONG"
	set {_bases::3} to 25000
	set {_ranks::4} to "THO_DAO"
	set {_bases::4} to 60000
	set {_ranks::5} to "DOI_TRUONG"
	set {_bases::5} to 150000
	set {_ranks::6} to "PHO_QUAN_NGUC"
	set {_bases::6} to 350000
	set {_ranks::7} to "QUAN_NGUC"
	set {_bases::7} to 800000
	set {_ranks::8} to "BA_CHU_NGUC_TU"
	set {_bases::8} to 1800000
	set {_ranks::9} to "VUOT_NGUC"
	set {_bases::9} to 4000000

	set {_moneypercents::1} to 0.05
	set {_moneypercents::2} to 0.08
	set {_moneypercents::3} to 0.12
	set {_moneypercents::4} to 0.18

	set {_stonecosts::1} to 8
	set {_stonecosts::2} to 16
	set {_stonecosts::3} to 32
	set {_stonecosts::4} to 64

	set {_successrates::1} to 70
	set {_successrates::2} to 50
	set {_successrates::3} to 30
	set {_successrates::4} to 15

	loop {_ranks::*}:
		set {_rankslug} to loop-value
		set {_index} to loop-index
		set {_base} to {_bases::%{_index}%}
		loop 4 times:
			set {_step} to loop-number
			set {_nextstep} to {_step} + 1
			set {_curid} to "PICKAXE_%{_rankslug}%_%{_step}%"
			set {_nextid} to "PICKAXE_%{_rankslug}%_%{_nextstep}%"
			set {pickaxe_next::%{_curid}%} to {_nextid}
			set {pickaxe_stoneid::%{_curid}%} to "DA_NANG_CAP_%{_rankslug}%"
			set {pickaxe_stonecost::%{_curid}%} to {_stonecosts::%{_step}%}
			set {pickaxe_success::%{_curid}%} to {_successrates::%{_step}%}
			set {_moneycost} to round({_base} * {_moneypercents::%{_step}%})
			set {pickaxe_moneycost::%{_curid}%} to {_moneycost}
	send "[pickaxe-upgrade] Da nap %(size of {_ranks::*}) * 4% cong thuc nang cap (tien + ti le that bai)." to console

command /nangcapcuoc:
	trigger:
		set {_item} to player's tool
		if {_item} is air:
			send "&cBạn cần cầm cuốc trên tay để nâng cấp." to player
			stop trigger
		set {_nbt} to try NBTItem.get({_item})
		if {_nbt} is not set:
			send "&cKhông đọc được vật phẩm này." to player
			stop trigger
		set {_curid} to try {_nbt}.getString("MMOITEMS_ITEM_ID")
		if {_curid} is not set:
			send "&cĐây không phải cuốc Prison hợp lệ." to player
			stop trigger
		if {_curid} is "":
			send "&cĐây không phải cuốc Prison hợp lệ." to player
			stop trigger
		if {pickaxe_next::%{_curid}%} is not set:
			send "&eCuốc này đã đạt cấp tối đa, không thể nâng cấp thêm." to player
			stop trigger

		set {_nextid} to {pickaxe_next::%{_curid}%}
		set {_stoneid} to {pickaxe_stoneid::%{_curid}%}
		set {_stonecost} to {pickaxe_stonecost::%{_curid}%}
		set {_moneycost} to {pickaxe_moneycost::%{_curid}%}
		set {_successrate} to {pickaxe_success::%{_curid}%}

		if player's balance < {_moneycost}:
			send "&cBạn cần &f$%round({_moneycost})%&c để thử nâng cấp, hiện bạn có &f$%round(player's balance)%&c." to player
			stop trigger

		set {_stonecount} to 0
		loop all items in player's inventory:
			if loop-value is not air:
				set {_realitem} to item in loop-value
				set {_checknbt} to try NBTItem.get({_realitem})
				if {_checknbt} is set:
					set {_checkid} to try {_checknbt}.getString("MMOITEMS_ITEM_ID")
					if {_checkid} is {_stoneid}:
						add (amount of {_realitem}) to {_stonecount}

		if {_stonecount} < {_stonecost}:
			send "&cBạn cần &f%{_stonecost}%&c Đá Nâng Cấp, hiện chỉ có &f%{_stonecount}%&c." to player
			stop trigger

		remove {_moneycost} from player's balance
		make console execute command "mmoitems take MATERIAL %{_stoneid}% %player's name% %{_stonecost}%"

		set {_roll} to a random integer between 1 and 100
		if {_roll} <= {_successrate}:
			make console execute command "mmoitems take TOOL %{_curid}% %player's name% 1"
			make console execute command "mmoitems give TOOL %{_nextid}% %player's name% 1"
			send "&a&lTHÀNH CÔNG! &7(tỉ lệ %{_successrate}%%%) &aNâng cấp lên %{_nextid}%. Đã tốn &f$%round({_moneycost})%&a + &f%{_stonecost}%&a đá." to player
		else:
			send "&c&lTHẤT BẠI! &7(tỉ lệ %{_successrate}%%%) &cMất &f$%round({_moneycost})%&c + &f%{_stonecost}%&c đá, cuốc vẫn giữ nguyên, thử lại sau." to player
