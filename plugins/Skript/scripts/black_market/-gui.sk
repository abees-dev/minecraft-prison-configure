# ============================================================================
# HỆ THỐNG CHỢ ĐEN — GUI HIỂN THỊ & CLICK EVENTS
# File: plugins/Skript/scripts/black_market/gui.sk
# Functions: open_bm_gui, open_bm_confirm_gui, open_bm_my_gui
# ============================================================================

# --- Helper: Tính thời gian còn lại ---
function bm_time_remaining(ts: timespan) :: text:
	if {_ts} > 1 hour:
		return "%round({_ts} / 1 hour)% giờ"
	if {_ts} > 1 minute:
		return "%round({_ts} / 1 minute)% phút"
	return "< 1 phút"

# ============================================================================
# GUI CHÍNH — DANH SÁCH LISTINGS (6 rows, phân trang)
# ============================================================================
function open_bm_gui(p: player, page: number):
	set {_title} to get_bm_gui_title()
	set {_inv} to a new chest inventory with 6 rows named {_title}

	# Filler kính xám
	loop 54 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named "&7"

	# Row 5: Divider
	loop 9 times:
		set slot (35 + loop-number) of {_inv} to black stained glass pane named "&8"

	# Row 6: Điều hướng
	set slot 47 of {_inv} to book named "&6&l📋 LISTINGS CỦA TÔI" with lore "&7Click để xem listings bạn đang bán.", "&e➤ Click để mở"
	set slot 49 of {_inv} to nether star named "&b&lℹ HƯỚNG DẪN CHỢ ĐEN" with lore "&7Bán vật phẩm cho người chơi khác!", "&f", "&e/choden sell money <giá> &7- Bán bằng Money", "&e/choden sell point <giá> &7- Bán bằng Points", "&e/choden cancel <id> &7- Hủy listing", "&e/choden nhan &7- Nhận item hết hạn", "&f", "&7• Giá tối thiểu: &e%get_bm_min_price()%", "&7• Tối đa: &e%get_bm_max_listings()% listings &7cùng lúc", "&7• Thuế: &e%round(get_bm_tax_rate() * 100)%%% &7(người bán chịu)", "&7• Hết hạn: &e24 giờ &7→ nhận lại trong &e7 ngày"
	set slot 51 of {_inv} to chest named "&a&l💰 ĐĂNG BÁN VẬT PHẨM" with lore "&7Cầm item trên tay rồi gõ lệnh:", "&f", "&e/choden sell money <giá>", "&e/choden sell point <giá>", "&f", "&7Item sẽ bị lấy khỏi tay ngay khi đăng bán."

	# Phân trang
	set {_per_page} to 36
	set {_total} to size of {bm_ids::*}
	set {_max_page} to ceil({_total} / {_per_page})
	if {_max_page} < 1:
		set {_max_page} to 1
	if {_page} < 1:
		set {_page} to 1
	if {_page} > {_max_page}:
		set {_page} to {_max_page}

	# Nút trang trước/sau
	if {_page} > 1:
		set slot 45 of {_inv} to arrow named "&e&l◀ Trang Trước" with lore "&7Trang %{_page} - 1%/%{_max_page}%"
	else:
		set slot 45 of {_inv} to gray stained glass pane named "&7"

	if {_page} < {_max_page}:
		set slot 53 of {_inv} to arrow named "&e&lTrang Sau ▶" with lore "&7Trang %{_page} + 1%/%{_max_page}%"
	else:
		set slot 53 of {_inv} to gray stained glass pane named "&7"

	# Fill listings cho trang hiện tại
	set {_start} to ({_page} - 1) * {_per_page} + 1
	set {_slot_idx} to 0
	set {_item_idx} to 0
	set {_now} to now
	set {_expire_secs} to get_bm_expire_seconds()

	loop {bm_ids::*}:
		add 1 to {_item_idx}
		if {_item_idx} >= {_start}:
			if {_slot_idx} < {_per_page}:
				set {_id} to loop-value
				set {_listing_item} to {bm_listing::%{_id}%::item}
				set {_price_type} to {bm_listing::%{_id}%::price_type}
				set {_price} to {bm_listing::%{_id}%::price}
				set {_seller_name} to {bm_listing::%{_id}%::seller_name}
				set {_ts} to {bm_listing::%{_id}%::timestamp}

				# Tính thời gian còn lại
				set {_elapsed} to difference between {_now} and {_ts}
				set {_remaining} to ({_expire_secs} seconds) - {_elapsed}
				if {_remaining} < 0 seconds:
					set {_time_str} to "&cSắp hết hạn"
				else:
					set {_time_str} to bm_time_remaining({_remaining})

				# Tạo lore
				if {_price_type} is "money":
					set {_price_str} to "&e$%{_price}% Money"
				else:
					set {_price_str} to "&b%{_price}% Points"

				# Đặt item với custom lore (clone item để giữ NBT)
				set slot {_slot_idx} of {_inv} to {_listing_item}

				# Tag slot với listing ID để xử lý click
				# Lưu mapping slot → ID vào biến tạm của player
				set {bm_gui_slot::%uuid of {_p}%::%{_slot_idx}%} to {_id}

				add 1 to {_slot_idx}

	# Lưu trang hiện tại
	set {bm_gui_page::%uuid of {_p}%} to {_page}

	open {_inv} to {_p}

# ============================================================================
# GUI XÁC NHẬN MUA (3 rows)
# ============================================================================
function open_bm_confirm_gui(p: player, id: number):
	# Check listing còn tồn tại
	if {bm_listing::%{_id}%::seller} is not set:
		send "&c&l[CHỢ ĐEN] &fListing này không còn tồn tại!" to {_p}
		return

	set {_title} to get_bm_confirm_title()
	set {_inv} to a new chest inventory with 3 rows named {_title}

	# Filler
	loop 27 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named "&7"

	# Slot 4: Preview item
	set {_item} to {bm_listing::%{_id}%::item}
	set slot 4 of {_inv} to {_item}

	# Thông tin listing
	set {_price_type} to {bm_listing::%{_id}%::price_type}
	set {_price} to {bm_listing::%{_id}%::price}
	set {_seller_name} to {bm_listing::%{_id}%::seller_name}
	set {_tax} to get_bm_tax_rate()

	if {_price_type} is "money":
		set {_price_str} to "&e$%{_price}% Money"
	else:
		set {_price_str} to "&b%{_price}% Points"

	# Slot 13: Info
	set slot 13 of {_inv} to paper named "&e&lTHÔNG TIN GIAO DỊCH" with lore "&7Người bán: &e%{_seller_name}%", "&7Giá: %{_price_str}%", "&7Thuế: &c%round({_tax} * 100)%%% &7(người bán chịu)", "&f", "&a➤ Click &a&l✔ XÁC NHẬN &ađể mua", "&c➤ Click &c&l✖ HỦY BỎ &cđể quay lại"

	# Slot 11: Xác nhận mua
	set slot 11 of {_inv} to lime concrete named "&a&l✔ XÁC NHẬN MUA" with lore "&7Click để mua item này!", "&7Bạn sẽ trả: %{_price_str}%"

	# Slot 15: Hủy bỏ
	set slot 15 of {_inv} to red concrete named "&c&l✖ HỦY BỎ" with lore "&7Click để quay lại Chợ Đen."

	# Lưu listing ID cho click event
	set {bm_confirm_id::%uuid of {_p}%} to {_id}

	open {_inv} to {_p}

# ============================================================================
# GUI LISTINGS CỦA TÔI (6 rows)
# ============================================================================
function open_bm_my_gui(p: player):
	set {_title} to get_bm_my_title()
	set {_inv} to a new chest inventory with 6 rows named {_title}
	set {_uuid} to uuid of {_p}

	# Filler
	loop 54 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named "&7"

	# Row 5: Divider
	loop 9 times:
		set slot (35 + loop-number) of {_inv} to black stained glass pane named "&8"

	# Slot 49: Quay lại chợ đen
	set slot 49 of {_inv} to arrow named "&e&l◀ QUAY LẠI CHỢ ĐEN" with lore "&7Click để quay lại danh sách Chợ Đen."

	# Fill listings của player
	set {_slot_idx} to 0
	set {_now} to now
	set {_expire_secs} to get_bm_expire_seconds()

	loop {bm_ids::*}:
		set {_id} to loop-value
		if {bm_listing::%{_id}%::seller} is {_uuid}:
			if {_slot_idx} < 36:
				set {_item} to {bm_listing::%{_id}%::item}
				set {_price_type} to {bm_listing::%{_id}%::price_type}
				set {_price} to {bm_listing::%{_id}%::price}
				set {_ts} to {bm_listing::%{_id}%::timestamp}

				set {_elapsed} to difference between {_now} and {_ts}
				set {_remaining} to ({_expire_secs} seconds) - {_elapsed}
				if {_remaining} < 0 seconds:
					set {_time_str} to "&cSắp hết hạn"
				else:
					set {_time_str} to bm_time_remaining({_remaining})

				set slot {_slot_idx} of {_inv} to {_item}
				set {bm_my_slot::%{_uuid}%::%{_slot_idx}%} to {_id}

				add 1 to {_slot_idx}

	if {_slot_idx} is 0:
		set slot 22 of {_inv} to barrier named "&c&lKHÔNG CÓ LISTINGS" with lore "&7Bạn chưa đăng bán gì.", "&7Dùng &e/choden sell money/point <giá> &7để bán."

	open {_inv} to {_p}

# ============================================================================
# CLICK EVENTS
# ============================================================================
on inventory click:
	# --- GUI CHÍNH ---
	set {_title_main} to get_bm_gui_title()
	if name of top inventory of player contains {_title_main}:
		cancel event
		if clicked inventory is top inventory of player:
			set {_slot} to index of clicked slot
			set {_uuid} to uuid of player

			# Trang trước
			if {_slot} is 45:
				set {_page} to {bm_gui_page::%{_uuid}%} ? 1
				if {_page} > 1:
					open_bm_gui(player, {_page} - 1)
				stop

			# Trang sau
			if {_slot} is 53:
				set {_page} to {bm_gui_page::%{_uuid}%} ? 1
				set {_total} to size of {bm_ids::*}
				set {_max_page} to ceil({_total} / 36)
				if {_max_page} < 1:
					set {_max_page} to 1
				if {_page} < {_max_page}:
					open_bm_gui(player, {_page} + 1)
				stop

			# Listings của tôi
			if {_slot} is 47:
				open_bm_my_gui(player)
				stop

			# Slot 49: Info (không làm gì)
			if {_slot} is 49:
				stop

			# Slot 51: Hướng dẫn bán (không làm gì)
			if {_slot} is 51:
				stop

			# Click vào listing (slot 0-35)
			if {_slot} is between 0 and 35:
				set {_listing_id} to {bm_gui_slot::%{_uuid}%::%{_slot}%}
				if {_listing_id} is set:
					open_bm_confirm_gui(player, {_listing_id})
				stop
		stop

	# --- GUI XÁC NHẬN MUA ---
	set {_title_confirm} to get_bm_confirm_title()
	if name of top inventory of player contains {_title_confirm}:
		cancel event
		if clicked inventory is top inventory of player:
			set {_slot} to index of clicked slot
			set {_uuid} to uuid of player

			# Xác nhận mua
			if {_slot} is 11:
				set {_id} to {bm_confirm_id::%{_uuid}%}
				if {_id} is set:
					if bm_check_cooldown(player) is true:
						close inventory of player
						bm_buy_listing(player, {_id})
				stop

			# Hủy bỏ — quay lại chợ đen
			if {_slot} is 15:
				set {_page} to {bm_gui_page::%{_uuid}%} ? 1
				open_bm_gui(player, {_page})
				stop
		stop

	# --- GUI LISTINGS CỦA TÔI ---
	set {_title_my} to get_bm_my_title()
	if name of top inventory of player contains {_title_my}:
		cancel event
		if clicked inventory is top inventory of player:
			set {_slot} to index of clicked slot
			set {_uuid} to uuid of player

			# Quay lại chợ đen
			if {_slot} is 49:
				open_bm_gui(player, 1)
				stop

			# Click vào listing để hủy
			if {_slot} is between 0 and 35:
				set {_listing_id} to {bm_my_slot::%{_uuid}%::%{_slot}%}
				if {_listing_id} is set:
					if bm_check_cooldown(player) is true:
						bm_cancel_listing(player, {_listing_id})
						open_bm_my_gui(player)
				stop
		stop

# ============================================================================
# CLEANUP GUI TEMP VARIABLES ON CLOSE
# ============================================================================
on inventory close:
	set {_uuid} to uuid of player
	set {_title_main} to get_bm_gui_title()
	set {_title_confirm} to get_bm_confirm_title()
	set {_title_my} to get_bm_my_title()

	if name of event-inventory contains {_title_main}:
		loop 36 times:
			delete {bm_gui_slot::%{_uuid}%::%loop-number - 1%}
		delete {bm_gui_page::%{_uuid}%}

	if name of event-inventory contains {_title_confirm}:
		delete {bm_confirm_id::%{_uuid}%}

	if name of event-inventory contains {_title_my}:
		loop 36 times:
			delete {bm_my_slot::%{_uuid}%::%loop-number - 1%}
