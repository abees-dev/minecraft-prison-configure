# ============================================================================
# HỆ THỐNG CHỢ ĐEN — CẤU HÌNH
# File: plugins/Skript/scripts/black_market/config.sk
# ============================================================================

function get_bm_gui_title() :: text:
	return "&8[&c✦&8] &c&lCHỢ ĐEN"

function get_bm_confirm_title() :: text:
	return "&8[&c✦&8] &e&lXÁC NHẬN MUA"

function get_bm_my_title() :: text:
	return "&8[&c✦&8] &6&lLISTINGS CỦA TÔI"

function get_bm_expired_title() :: text:
	return "&8[&c✦&8] &c&lITEM HẾT HẠN"

function get_bm_min_price() :: number:
	return 10 # Giá tối thiểu mỗi listing

function get_bm_max_listings() :: number:
	return 5 # Max listings mỗi người chơi

function get_bm_tax_rate() :: number:
	return 0.05 # Thuế 5% (người bán nhận 95%)

function get_bm_expire_seconds() :: number:
	return 86400 # 24 giờ = 86400 giây

function get_bm_refund_days() :: number:
	return 7 # 7 ngày để nhận item hết hạn trước khi xóa

function get_bm_cooldown_seconds() :: number:
	return 3 # Cooldown 3 giây giữa các thao tác
