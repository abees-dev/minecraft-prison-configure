# ============================================================================
# AUTOMATIC SCRIPT MODULE LOADER ON SERVER START
# File: plugins/Skript/scripts/00_system_loader.sk
# ============================================================================

on load:
	wait 3 seconds
	execute console command "sk reload admin/"
	send "&a[Auto-Loader] Đã tự động nạp toàn bộ Skript modules sau khi server khởi động!" to console
