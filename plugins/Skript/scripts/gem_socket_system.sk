import:
	io.lumine.mythic.lib.api.item.NBTItem
	net.Indyuce.mmoitems.api.item.mmoitem.LiveMMOItem
	net.Indyuce.mmoitems.ItemStats
	net.Indyuce.mmoitems.stat.data.GemSocketsData
	java.util.ArrayList

# ==============================================================================
# HỆ THỐNG ĐỤC LỖ VŨ KHÍ / GIÁP BẰNG ĐÁ ĐỤC LỖ (SOCKET PUNCH SYSTEM)
# Sử dụng trực tiếp Bukkit Event API via skript-reflect tương thích 100%
# ==============================================================================
on inventory click:
	set {_cursor} to event.getCursor()
	set {_item} to event.getCurrentItem()

	if {_cursor} is not set:
		stop
	if {_cursor} is air:
		stop
	if {_item} is not set:
		stop
	if {_item} is air:
		stop

	set {_nbtCursor} to try NBTItem.get({_cursor})
	if {_nbtCursor} is not set:
		stop
	if {_nbtCursor}.hasTag("MMOITEMS_ITEM_ID") is false:
		stop

	set {_cursorId} to try {_nbtCursor}.getString("MMOITEMS_ITEM_ID")

	# Chỉ xử lý nếu con trỏ chuột đang cầm 1 trong 3 loại Đá Đục Lỗ
	if {_cursorId} is "DA_DUC_LO_1" or "DA_DUC_LO_2" or "DA_DUC_LO_3":
		cancel event

		set {_nbtItem} to try NBTItem.get({_item})
		if {_nbtItem} is not set:
			send "&cVật phẩm này không thể đục lỗ khảm đá quý!" to player
			stop

		if {_nbtItem}.hasTag("MMOITEMS_ITEM_TYPE") is false:
			send "&cVật phẩm này không thể đục lỗ khảm đá quý!" to player
			stop

		set {_itemType} to {_nbtItem}.getString("MMOITEMS_ITEM_TYPE")
		if {_itemType} is "GEM_STONE" or "CONSUMABLE" or "MATERIAL" or "MISCELLANEOUS":
			send "&cVật phẩm loại này không thể đục lỗ!" to player
			stop

		set {_mmoItem} to try new LiveMMOItem({_nbtItem})
		if {_mmoItem} is not set:
			send "&cKhông thể xử lý dữ liệu vật phẩm này!" to player
			stop
		
		if {_mmoItem}.hasData(ItemStats.GEM_SOCKETS) is false:
			set {_emptyList} to new ArrayList()
			set {_data} to new GemSocketsData({_emptyList})
			{_mmoItem}.setData(ItemStats.GEM_SOCKETS, {_data})
		else:
			set {_data} to {_mmoItem}.getData(ItemStats.GEM_SOCKETS)

		set {_socketList} to {_data}.getSockets()
		set {_socketCount} to {_socketList}.size()

		if {_socketCount} >= 3:
			send "&c&l[!] &cVật phẩm này đã đục tối đa &e3 Ô Khảm Đá Quý&c!" to player
			stop

		# Kiểm tra cấp độ Đá Đục Lỗ tương ứng với số ô hiện tại
		if {_cursorId} is "DA_DUC_LO_1":
			if {_socketCount} > 0:
				send "&c&l[!] &cĐá Đục Lỗ Sơ Cấp chỉ dùng để đục &eÔ Khảm Thứ 1&c! (Vật phẩm đã có %{_socketCount}% ô)" to player
				stop
			set {_rate} to 100

		else if {_cursorId} is "DA_DUC_LO_2":
			if {_socketCount} is 0:
				send "&c&l[!] &cVật phẩm chưa có Ô Khảm Thứ 1! Hãy dùng &bĐá Đục Lỗ Sơ Cấp &ctrước." to player
				stop
			else if {_socketCount} > 1:
				send "&c&l[!] &cĐá Đục Lỗ Trung Cấp chỉ dùng để đục &eÔ Khảm Thứ 2&c!" to player
				stop
			set {_rate} to 70

		else if {_cursorId} is "DA_DUC_LO_3":
			if {_socketCount} < 2:
				send "&c&l[!] &cVật phẩm chưa có Ô Khảm Thứ 2! Hãy đục đủ 2 ô trước." to player
				stop
			set {_rate} to 40

		# Trừ 1 Đá Đục Lỗ trên con trỏ chuột
		set {_amt} to {_cursor}.getAmount()
		if {_amt} > 1:
			{_cursor}.setAmount({_amt} - 1)
			event.setCursor({_cursor})
		else:
			event.setCursor(null)

		# Thực hiện tỷ lệ thành công
		set {_chance} to random integer between 1 and 100
		if {_chance} <= {_rate}:
			{_data}.addEmptySocket("Uncolored")
			set {_builder} to {_mmoItem}.newBuilder()
			set {_newItem} to {_builder}.build()
			event.setCurrentItem({_newItem})
			play sound "block.anvil.use" with volume 1.0 and pitch 1.2 at player
			play sound "entity.player.levelup" with volume 0.8 and pitch 1.5 at player
			send "&a&l[THÀNH CÔNG] &gĐã đục thành công Ô Khảm Thứ %{_socketCount} + 1% vào trang bị của bạn!" to player
		else:
			play sound "entity.item.break" with volume 1.0 and pitch 0.8 at player
			send "&c&l[THẤT BẠI] &cĐục lỗ thất bại (%{_chance}%%% / %{_rate}%%%)! Đá đục lỗ đã bị tiêu hao." to player
