name: '&8[&5◆&8] &5&lBÀN TIẾN HÓA LONG TỘC (#page#/#max#)'
max-queue-size: 10
sound: BLOCK_ANVIL_USE
layout: trade-5x5

items:
    fill:
        material: GRAY_STAINED_GLASS_PANE
        name: '&7'
    no-recipe:
        material: RED_STAINED_GLASS_PANE
        name: '&cChưa Chọn Công Thức'
    no-queue-item:
        material: BLACK_STAINED_GLASS_PANE
        name: '&7Ô Hàng Chờ Trống'

