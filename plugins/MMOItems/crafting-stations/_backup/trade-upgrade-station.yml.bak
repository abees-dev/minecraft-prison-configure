    # ==========================================================
    # HÀNG 1: HỎA LONG (Cấp 1 - RARE) [VN5 → Hỏa Long]
    # ==========================================================
    kiem-hoa-long:
        output:
            type: SWORD
            id: TRADE_SWORD_HOA_LONG
            amount: 1
        name: "&6✦ Tiến Hóa Hỏa Long Kiếm"
        crafting-time: 0
        ingredients:
        - mmoitem{type=SWORD,id=SWORD_VUOT_NGUC_5,amount=1,display="Kiếm Vượt Ngục V"}
        # TODO: Thêm nguyên liệu nâng cấp tại đây

